/* ==========================================================================
   PortfolioOptimizationRiskManagementPage.module.css
   Cream / black / gold system, small restrained type scale (px-based).
   ========================================================================== */

@import url("https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Inter:wght@300;400;500;600;700&display=swap");

:root {
  --cream: #f4f1eb;
  --cream-dark: #ece9e1;
  --black: #0a0a0a;
  --black-soft: #141414;
  --gold: #d0af76;
  --gold-light: #e4ca9e;
  --bronze: #b89352;
  --bronze-dark: #896629;
  --white: #ffffff;
  --gray-600: #575757;
  --gray-400: #828282;
  --gray-200: #cfcdc7;
  --border-soft: rgba(0, 0, 0, 0.12);
  --border-soft-dark: rgba(255, 255, 255, 0.12);

  --font-display: "Manrope", sans-serif;
  --font-body: "Manrope", sans-serif;

  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 16px;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
}

@media (max-width: 767px) {
  .container { padding: 0 16px; }
}

section { font-family: var(--font-body); }

h1, h2, h3, h4, h5 {
  font-family: var(--font-display);
  letter-spacing: -0.01em;
  color: var(--black);
  margin: 0;
}

/* ── Hero ─────────────────────────────────────────────────────────────── */

.heroSection {
  position: relative;
  background: var(--cream);
  padding: 56px 0 48px;
  overflow: hidden;
}

.heroBg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 900px 500px at 85% -10%, rgba(208, 175, 118, 0.28), transparent 60%),
    radial-gradient(ellipse 700px 500px at -10% 110%, rgba(184, 147, 82, 0.14), transparent 60%);
  pointer-events: none;
}

.heroGrid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 48px;
  align-items: center;
}

@media (max-width: 991px) {
  .heroGrid { grid-template-columns: 1fr; gap: 32px; }
}

.heroBadge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border-radius: 100px;
  background: var(--black);
  color: var(--gold-light);
  font-size: 15px;
  font-weight: 500;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  margin-bottom: 20px;
}

.heroTitle {
  font-size: 35px;
  line-height: 1.15;
  font-weight: 400;
  color: var(--black);
  margin-bottom: 14px;
}

.highlight {
  color: var(--bronze-dark);
  font-style: italic;
}

.heroSub {
  font-family: var(--font-body);
  font-size: 18px;
  line-height: 1.55;
  color: var(--gray-600);
  max-width: 420px;
  margin-bottom: 22px;
}

.heroCta {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 32px;
  flex-wrap: wrap;
}

.heroBtn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--black);
  color: var(--white);
  padding: 11px 18px;
  border-radius: var(--radius-sm);
  font-family: var(--font-body);
  font-size: 17px;
  font-weight: 500;
  text-decoration: none;
  transition: background 0.2s ease, transform 0.2s ease;
}

.heroBtn:hover { background: var(--bronze-dark); transform: translateY(-1px); }

.heroBtnSecondary {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--black);
  font-family: var(--font-body);
  font-size: 17px;
  font-weight: 500;
  text-decoration: none;
  border-bottom: 1px solid var(--black);
  padding-bottom: 2px;
  transition: color 0.2s ease, border-color 0.2s ease;
}

.heroBtnSecondary:hover { color: var(--bronze-dark); border-color: var(--bronze-dark); }

.heroStats {
  display: flex;
  gap: 32px;
  padding-top: 22px;
  border-top: 1px solid var(--border-soft);
}

@media (max-width: 479px) {
  .heroStats { gap: 20px; flex-wrap: wrap; }
}

.statItem { display: flex; flex-direction: column; gap: 3px; }

.statValue {
  font-family: var(--font-display);
  font-size: 27px;
  color: var(--bronze-dark);
}

.statLabel {
  font-size: 14px;
  color: var(--gray-600);
  letter-spacing: 0.01em;
}

/* ── Hero demo form card ─────────────────────────────────────────────── */

.heroForm { position: relative; }

.formCard {
  background: var(--white);
  border: 1px solid var(--border-soft);
  border-radius: var(--radius-lg);
  padding: 22px;
  box-shadow: 0 24px 50px -30px rgba(10, 10, 10, 0.25);
}

.formCard h4 { font-size: 22px; margin-bottom: 6px; }

.formCard > p {
  font-family: var(--font-body);
  color: var(--gray-600);
  font-size: 16px;
  margin-bottom: 18px;
}

.demoForm { display: flex; flex-direction: column; gap: 10px; }

.demoForm input,
.selectInput {
  font-family: var(--font-body);
  font-size: 17px;
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-soft);
  background: var(--cream);
  color: var(--black);
  outline: none;
  transition: border-color 0.2s ease;
}

.demoForm input:focus,
.selectInput:focus { border-color: var(--bronze); }

.selectInput { appearance: none; cursor: pointer; }

.submitBtn {
  margin-top: 6px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  background: var(--black);
  color: var(--white);
  border: none;
  padding: 11px 16px;
  border-radius: var(--radius-sm);
  font-family: var(--font-body);
  font-size: 17px;
  font-weight: 500;
  cursor: pointer;
  transition: background 0.2s ease;
}

.submitBtn:hover { background: var(--bronze-dark); }
.submitBtn:disabled { opacity: 0.7; cursor: not-allowed; }

.privacy {
  margin-top: 12px;
  font-size: 14px;
  color: var(--gray-400);
  text-align: center;
}

/* ── Video / intro split ──────────────────────────────────────────────── */

.videoSection { background: var(--white); padding: 56px 0; }

.videoGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: center;
}

@media (max-width: 991px) {
  .videoGrid { grid-template-columns: 1fr; gap: 24px; }
}

.videoText h2 { font-size: 30px; line-height: 1.2; margin-bottom: 10px; }

.videoText p {
  font-family: var(--font-body);
  font-size: 18px;
  line-height: 1.6;
  color: var(--gray-600);
  max-width: 380px;
}

.videoImage { border-radius: var(--radius-lg); overflow: hidden; }

.videoImg {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  border-radius: var(--radius-lg);
}

/* ── Features list ────────────────────────────────────────────────────── */

.featuresListSection { background: var(--cream); padding: 56px 0; }

.sectionTitleSmall {
  font-size: 27px;
  line-height: 1.25;
  text-align: center;
  max-width: 460px;
  margin: 0 auto 32px;
}

.featuresList {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px 16px;
}

@media (max-width: 991px) { .featuresList { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 640px) { .featuresList { grid-template-columns: 1fr; } }

.featuresListItem {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  padding: 16px;
  border-radius: var(--radius-md);
  background: var(--white);
  border: 1px solid var(--border-soft);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.featuresListItem:hover {
  transform: translateY(-3px);
  box-shadow: 0 20px 40px -24px rgba(10, 10, 10, 0.2);
}

.featuresListItemIcon {
  flex-shrink: 0;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  overflow: hidden;
  background: var(--gold-light);
}

.featuresListItemImg { width: 100%; height: 100%; object-fit: cover; }

.featuresListItemContent h3 { font-size: 18px; margin-bottom: 4px; }

.featuresListItemContent p {
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.5;
  color: var(--gray-600);
}

.featuresCta { display: flex; justify-content: center; margin-top: 32px; }

.btnRed {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--black);
  color: var(--gold-light);
  padding: 11px 22px;
  border-radius: 100px;
  font-family: var(--font-body);
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-decoration: none;
  transition: background 0.2s ease, color 0.2s ease;
}

.btnRed:hover { background: var(--bronze-dark); color: var(--white); }

/* ── Features grid ─────────────────────────────────────────────────────── */

.featuresGridSection { background: var(--white); padding: 56px 0; }

.featuresGrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }

@media (max-width: 991px) { .featuresGrid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 640px) { .featuresGrid { grid-template-columns: 1fr; } }

.featureCard {
  padding: 22px 16px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-soft);
  background: var(--cream);
  transition: border-color 0.2s ease, transform 0.2s ease;
}

.featureCard:hover { border-color: var(--bronze); transform: translateY(-3px); }

.featureIcon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--black);
  color: var(--gold-light);
  margin-bottom: 14px;
}

.featureCard h3 { font-size: 19px; margin-bottom: 6px; }

.featureCard p {
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.55;
  color: var(--gray-600);
}

/* ── How it works ─────────────────────────────────────────────────────── */

.howSection { background: var(--black); padding: 56px 0; color: var(--white); }

.howTitle { font-size: 27px; color: var(--white); text-align: center; margin-bottom: 32px; }

.howGrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }

@media (max-width: 991px) { .howGrid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 640px) { .howGrid { grid-template-columns: 1fr; } }

.howCard {
  padding: 18px 16px;
  border-radius: var(--radius-md);
  background: var(--black-soft);
  border: 1px solid var(--border-soft-dark);
  transition: border-color 0.2s ease;
}

.howCard:hover { border-color: var(--gold); }

.howIcon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--gold);
  color: var(--black);
  margin-bottom: 12px;
}

.howCardTitle { font-size: 18px; color: var(--white); margin-bottom: 4px; }

.howCardText {
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.55;
  color: var(--gray-200);
}

/* ── Benefits ─────────────────────────────────────────────────────────── */

.benefitsSection { background: var(--cream); padding: 56px 0; }

.benefitsGrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px 16px; }

@media (max-width: 991px) { .benefitsGrid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 640px) { .benefitsGrid { grid-template-columns: 1fr; } }

.benefitCard { display: flex; gap: 12px; align-items: flex-start; }

.benefitIcon {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: var(--white);
  border: 1px solid var(--border-soft);
  color: var(--bronze-dark);
}

.benefitCard h3 { font-size: 18px; margin-bottom: 3px; }

.benefitCard p {
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.5;
  color: var(--gray-600);
}

/* ── Bottom split image section ──────────────────────────────────────── */

.bottomSection { background: var(--white); padding: 56px 0; }

.bottomGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: center;
}

@media (max-width: 991px) { .bottomGrid { grid-template-columns: 1fr; gap: 24px; } }

.bottomText h2 { font-size: 30px; line-height: 1.2; margin-bottom: 10px; }

.bottomText p {
  font-family: var(--font-body);
  font-size: 18px;
  line-height: 1.6;
  color: var(--gray-600);
  max-width: 380px;
}

.bottomImage { border-radius: var(--radius-lg); overflow: hidden; }

.bottomImg {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  border-radius: var(--radius-lg);
}

/* ── FAQ ──────────────────────────────────────────────────────────────── */

.faqSection { background: var(--cream); padding: 56px 0; }

.faqGrid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 40px; }

@media (max-width: 991px) { .faqGrid { grid-template-columns: 1fr; gap: 24px; } }

.faqTitle { font-size: 30px; line-height: 1.2; margin-bottom: 10px; }

.faqText {
  font-family: var(--font-body);
  font-size: 18px;
  line-height: 1.55;
  color: var(--gray-600);
  max-width: 320px;
}

.faqRight { display: flex; flex-direction: column; }

.faqItem { border-bottom: 1px solid var(--border-soft); }
.faqItem:first-child { border-top: 1px solid var(--border-soft); }

.faqQuestion {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 16px 0;
  background: none;
  border: none;
  cursor: pointer;
  text-align: left;
}

.faqQuestion h3 { font-size: 18px; font-weight: 500; color: var(--black); }

.faqPlus { position: relative; flex-shrink: 0; width: 16px; height: 16px; }

.faqPlus::before,
.faqPlus::after {
  content: "";
  position: absolute;
  background: var(--black);
  transition: transform 0.25s ease, opacity 0.25s ease;
}

.faqPlus::before { top: 50%; left: 0; width: 100%; height: 1.5px; transform: translateY(-50%); }
.faqPlus::after { left: 50%; top: 0; height: 100%; width: 1.5px; transform: translateX(-50%); }

.faqItemOpen .faqPlus::after { opacity: 0; transform: translateX(-50%) rotate(90deg); }
.faqItemOpen .faqQuestion h3 { color: var(--bronze-dark); }

.faqAnswer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease, padding 0.3s ease;
}

.faqAnswer p {
  font-family: var(--font-body);
  font-size: 17px;
  line-height: 1.6;
  color: var(--gray-600);
  padding-bottom: 0;
}

.faqItemOpen .faqAnswer { max-height: 300px; }
.faqItemOpen .faqAnswer p { padding-bottom: 16px; }

/* ── CTA ──────────────────────────────────────────────────────────────── */

.ctaSection { position: relative; background: var(--black); padding: 56px 0; overflow: hidden; }

.ctaBg {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 800px 400px at 50% 0%, rgba(208, 175, 118, 0.22), transparent 65%);
  pointer-events: none;
}

.ctaContent {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
  text-align: center;
}

.ctaContent h2 { font-size: 32px; color: var(--white); max-width: 340px; line-height: 1.2; }

.ctaBtn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--gold);
  color: var(--black);
  padding: 12px 24px;
  border-radius: var(--radius-sm);
  font-family: var(--font-body);
  font-size: 18px;
  font-weight: 600;
  text-decoration: none;
  transition: background 0.2s ease, transform 0.2s ease;
}

.ctaBtn:hover { background: var(--gold-light); transform: translateY(-1px); }

/* ── Scroll to top ────────────────────────────────────────────────────── */

.scrollTop {
  position: fixed;
  bottom: 20px;
  right: 20px;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--black);
  color: var(--gold-light);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow: 0 10px 24px -8px rgba(10, 10, 10, 0.5);
  z-index: 40;
}

.scrollTop:hover { background: var(--bronze-dark); }

@media (max-width: 640px) {
  .heroTitle { font-size: 27px; }
  .heroSub { font-size: 16px; }
  .sectionTitleSmall,
  .howTitle,
  .faqTitle,
  .videoText h2,
  .bottomText h2 { font-size: 24px; }
  .ctaContent h2 { font-size: 27px; }
}