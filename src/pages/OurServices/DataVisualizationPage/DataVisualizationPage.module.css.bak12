/* src/pages/Services/DataVisualization/DataVisualizationPage.module.css */

.hero {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    color: white;
    padding: 5rem 1.5rem;
}

.heroContent {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
}

.heroTitle {
    font-size: 3.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    line-height: 1.2;
}

.heroSubtitle {
    font-size: 1.25rem;
    color: #cbd5e1;
    max-width: 800px;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
}

.heroButton {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: #fdb840;
    color: #0f172a;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1.125rem;
    text-decoration: none;
    transition: all 0.3s ease;
}

.heroButton:hover {
    background: #f5a623;
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.25);
}

.sectionContent {
    max-width: 1200px;
    margin: 0 auto;
}

/* ── Deliverables ── */
.deliverablesSection {
    padding: 5rem 1.5rem;
    background: white;
}

.deliverablesGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
}

.deliverableCard {
    background: #f8fafc;
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    transition: all 0.3s ease;
}

.deliverableIcon {
    color: #3b82f6;
    margin-bottom: 1rem;
}

.deliverableTitle {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.75rem;
}

.deliverableDescription {
    color: #64748b;
    line-height: 1.6;
}

/* ── Process ── */
.processSection {
    padding: 5rem 1.5rem;
    background: #f8fafc;
}

.processGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
}

.processCard {
    background: white;
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.processStep {
    font-size: 2rem;
    font-weight: 700;
    color: #fdb840;
    margin-bottom: 0.75rem;
}

.processTitle {
    font-size: 1.15rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.5rem;
}

.processDescription {
    color: #64748b;
    line-height: 1.6;
    font-size: 0.95rem;
}

/* ── Tools ── */
.toolsSection {
    padding: 4rem 1.5rem;
    background: white;
}

.toolsRow {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
}

.toolChip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #eff6ff;
    color: #1e40af;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
}

/* ── CTA ── */
.ctaSection {
    background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 100%);
    color: white;
    padding: 5rem 1.5rem;
    text-align: center;
}

.ctaContent {
    max-width: 800px;
    margin: 0 auto;
}

.ctaTitle {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
}

.ctaText {
    font-size: 1.125rem;
    color: #bfdbfe;
    margin-bottom: 2rem;
}

.ctaButton {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: white;
    color: #1e40af;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1.125rem;
    text-decoration: none;
    transition: all 0.3s ease;
}

.ctaButton:hover {
    background: #f1f5f9;
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
}

@media (max-width: 768px) {
    .heroTitle {
        font-size: 2.5rem;
    }

    .ctaTitle {
        font-size: 2rem;
    }
}
