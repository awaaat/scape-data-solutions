                <motion.div
                  className={styles.industryCard}
                  key={ind.title}
                  variants={fadeUp}
                  whileHover={{ y: -4 }}
                >
                  <h3>{ind.title}</h3>
                  <p>{ind.desc}</p>
                  <div className={styles.industryTags}>
                    {ind.tags.map((t) => (
                      <span className={styles.industryTag} key={t}>{t}</span>
                    ))}
                  </div>
                </motion.div>
              ))}
            </motion.div>
          </div>
        </motion.section>

        {/* ===== WHY US ===== */}
        <motion.section
          className={styles.whySection}
          initial="hidden"
          whileInView="visible"
          viewport={{ amount: 0.15, once: false }}
          variants={staggerContainer}
        >
          <div className={styles.container}>
            <motion.div
              className={styles.sectionHeader}
              variants={fadeUp}
            >
              <h2>Why Work With Us</h2>
            </motion.div>
            <motion.div
              className={styles.whyGrid}
              variants={staggerContainer}
              initial="hidden"
              whileInView="visible"
              viewport={{ amount: 0.15, once: false }}
            >
              {WHY_US.map((w) => (
                <motion.div
                  className={styles.whyCard}
                  key={w.title}
                  variants={fadeUp}
                  whileHover={{ y: -4 }}
                >
                  <h3>{w.title}</h3>
                  <p>{w.desc}</p>
                </motion.div>
              ))}
            </motion.div>
          </div>
        </motion.section>

        {/* ===== TEAM ===== */}
        <motion.section
          className={styles.teamSection}
          initial="hidden"
          whileInView="visible"
          viewport={{ amount: 0.1, once: false }}
          variants={staggerContainer}
        >
          <div className={styles.container}>
            <motion.div
              className={styles.sectionHeader}
              variants={fadeUp}
            >
              <h2>AI Engineering Team</h2>
            </motion.div>
            <motion.div
              className={styles.teamGrid}
              variants={staggerContainer}
              initial="hidden"
              whileInView="visible"
              viewport={{ amount: 0.1, once: false }}
            >
              {TEAM.map((t) => (
                <motion.div
                  className={styles.teamCard}
                  key={t.name}
                  variants={scaleIn}
                  whileHover={{ y: -4 }}
                >
                  <div className={styles.teamAvatar}>{t.name.split(' ').map((n) => n[0]).join('')}</div>
                  <strong>{t.name}</strong>
                  <span>{t.role}</span>
                </motion.div>
              ))}
            </motion.div>
          </div>
        </motion.section>

        {/* ===== TECH STACK ===== */}
        <motion.section
          className={styles.techSection}
          initial="hidden"
          whileInView="visible"
          viewport={{ amount: 0.1, once: false }}
          variants={staggerContainer}
        >
          <div className={styles.container}>
            <motion.div
              className={styles.sectionHeader}
              variants={fadeUp}
            >
              <h2>Our Tech Expertise Matrix</h2>
              <p>We use the strongest technologies available and keep expanding the stack as the field moves.</p>
            </motion.div>
            <motion.div
              className={styles.techGroups}
              variants={staggerContainer}
              initial="hidden"
              whileInView="visible"
              viewport={{ amount: 0.1, once: false }}
            >
              {TECH_STACK.map((group) => (
                <motion.div
                  className={styles.techGroup}
                  key={group.group}
                  variants={fadeUp}
                >
                  <h3>{group.group}</h3>
                  <ul className={styles.techList}>
                    {group.items.map((item) => (
                      <li key={item}>{item}</li>
                    ))}
                  </ul>
                </motion.div>
              ))}
            </motion.div>
          </div>
        </motion.section>

        {/* ===== FAQ ===== */}
        <motion.section
          className={styles.faqSection}
          initial="hidden"
          whileInView="visible"
          viewport={{ amount: 0.1, once: false }}
          variants={staggerContainer}
        >
          <div className={styles.container}>
            <motion.div
              className={styles.sectionHeader}
              variants={fadeUp}
            >
              <h2>Frequently Asked Questions</h2>
            </motion.div>
            <motion.div
              className={styles.faqGrid}
              variants={staggerContainer}
              initial="hidden"
              whileInView="visible"
              viewport={{ amount: 0.1, once: false }}
            >
              {FAQS.map((item, i) => (
                <FAQItem
                  key={item.q}
                  item={item}
                  isOpen={openFaq === i}
                  onToggle={() => setOpenFaq(openFaq === i ? -1 : i)}
                />
              ))}
            </motion.div>
          </div>
        </motion.section>

        {/* ===== CONTACT ===== */}
        <motion.section
          id="contact"
          className={styles.ctaSection}
          initial="hidden"
          whileInView="visible"
          viewport={{ amount: 0.1, once: false }}
          variants={staggerContainer}
        >
          <div className={styles.container}>
            <motion.div
              className={styles.ctaBox}
              variants={scaleIn}
              transition={springTransition}
            >
              <h2>Contact Us</h2>
              <p>Tell us about your project — we'll help you build a solution that puts your data and AI investment to work.</p>
              <ContactForm />
            </motion.div>
          </div>
        </motion.section>
      </motion.div>

      <Footer />
    </>
  );
}