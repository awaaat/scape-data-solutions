.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
}

.heroSection {
  position: relative;
  min-height: 75vh;
  background: #0a0e1a;
  display: flex;
  align-items: center;
  padding: 80px 0 60px;
  overflow: hidden;
}

.heroOverlay {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 30% 50%, rgba(0, 255, 100, 0.06) 0%, transparent 70%);
  z-index: 0;
}

.heroContent {
  position: relative;
  z-index: 1;
  max-width: 820px;
  margin: 0 auto;
  text-align: center;
}

.heroBadge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(0, 255, 100, 0.10);
  border: 1px solid rgba(0, 255, 100, 0.15);
  color: #00ff64;
  padding: 6px 18px;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  border-radius: 30px;
  margin-bottom: 16px;
}

.heroTitle {
  font-size: 52px;
  font-weight: 800;
  line-height: 1.08;
  color: #ffffff;
  margin: 0 0 16px;
  letter-spacing: -0.02em;
}

.highlight {
  color: #00ff64;
}

.heroSub {
  font-size: 19px;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.7;
  max-width: 640px;
  margin: 0 auto 28px;
}

.heroCta {
  display: flex;
  gap: 14px;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 36px;
}

.heroBtn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 34px;
  background: #00ff64;
  color: #0a0e1a;
  font-weight: 700;
  font-size: 15px;
  border: none;
  border-radius: 6px;
  text-decoration: none;
  cursor: pointer;
  transition: background 0.25s, transform 0.15s;
}
.heroBtn:hover {
  background: #00e658;
}

.heroBtnSecondary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 30px;
  background: transparent;
  color: #ffffff;
  font-weight: 600;
  font-size: 15px;
  border: 2px solid rgba(255, 255, 255, 0.2);
  border-radius: 6px;
  text-decoration: none;
  transition: border-color 0.25s, color 0.25s;
}
.heroBtnSecondary:hover {
  border-color: #00ff64;
  color: #00ff64;
}

.heroStats {
  display: flex;
  justify-content: center;
  gap: 48px;
  margin-top: 12px;
}

.statItem {
  text-align: center;
}

.statValue {
  display: block;
  font-size: 32px;
  font-weight: 800;
  color: #00ff64;
}

.statLabel {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.4);
  text-transform: uppercase;
  letter-spacing: 0.4px;
}

.problemSection {
  padding: 60px 0 70px;
  background: #0f1422;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

.problemContent {
  text-align: center;
}

.problemLabel {
  display: inline-block;
  background: rgba(0, 255, 100, 0.08);
  color: #00ff64;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  padding: 4px 14px;
  border-radius: 20px;
  margin-bottom: 12px;
}

.problemContent h2 {
  font-size: 32px;
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 30px;
}
.problemContent h2 .highlight {
  color: #00ff64;
}

.problemGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  max-width: 900px;
  margin: 0 auto;
}

.problemStat {
  background: rgba(255, 255, 255, 0.02);
  padding: 24px 20px;
  border-radius: 8px;
  border: 1px solid rgba(255, 255, 255, 0.04);
}

.problemNumber {
  display: block;
  font-size: 28px;
  font-weight: 800;
  color: #00ff64;
  margin-bottom: 6px;
}

.problemStat p {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.5;
  margin: 0;
}

.overviewSection {
  padding: 80px 0;
  background: #0a0e1a;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

.overviewGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 50px;
  align-items: center;
}

.overviewText h2 {
  font-size: 36px;
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 16px;
}
.overviewText h2 .highlight {
  color: #00ff64;
}

.overviewText p {
  font-size: 16px;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.7);
  margin: 0 0 14px;
}
.overviewText p:last-child {
  margin-bottom: 0;
}

.overviewVisual {
  display: flex;
  justify-content: center;
  align-items: center;
}

.visualPlaceholder {
  width: 100%;
  max-width: 400px;
  aspect-ratio: 16 / 10;
  background: rgba(0, 255, 100, 0.04);
  border: 2px solid rgba(0, 255, 100, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 500;
  font-size: 15px;
  border-radius: 10px;
}
.visualPlaceholder svg {
  color: #00ff64;
}

.sectionTitle {
  font-size: 34px;
  font-weight: 700;
  color: #ffffff;
  text-align: center;
  margin: 0 0 8px;
}

.howSection {
  padding: 60px 0 70px;
  background: #0f1422;
}

.howGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  margin-top: 30px;
}

.howCard {
  background: rgba(255, 255, 255, 0.02);
  padding: 28px 24px;
  border: 1px solid rgba(255, 255, 255, 0.04);
  border-radius: 8px;
  transition: all 0.3s ease;
}
.howCard:hover {
  border-color: rgba(0, 255, 100, 0.12);
  background: rgba(0, 255, 100, 0.02);
}

.howIcon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  background: rgba(0, 255, 100, 0.06);
  border-radius: 8px;
  color: #00ff64;
  margin-bottom: 14px;
}

.howCard h3 {
  font-size: 17px;
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 8px;
}

.howCard p {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.6;
  margin: 0;
}

.deliverablesSection {
  padding: 60px 0;
  background: #0a0e1a;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

.deliverablesGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px 24px;
  margin-top: 30px;
  max-width: 800px;
  margin-left: auto;
  margin-right: auto;
}

.deliverableItem {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  padding: 12px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.03);
}
.deliverableItem:last-child {
  border-bottom: none;
}

.deliverableIcon {
  color: #00ff64;
  flex-shrink: 0;
  margin-top: 2px;
}

.deliverableItem h4 {
  font-size: 15px;
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 2px;
}

.deliverableItem p {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.4;
  margin: 0;
}

.featuresSection {
  padding: 60px 0;
  background: #0f1422;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

.featuresGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  margin-top: 30px;
}

.featureCard {
  background: rgba(255, 255, 255, 0.02);
  padding: 26px 22px;
  border: 1px solid rgba(255, 255, 255, 0.04);
  border-radius: 8px;
  transition: all 0.3s ease;
}
.featureCard:hover {
  border-color: rgba(0, 255, 100, 0.12);
  background: rgba(0, 255, 100, 0.02);
}

.featureIcon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  background: rgba(0, 255, 100, 0.04);
  border-radius: 8px;
  color: #00ff64;
  margin-bottom: 12px;
}

.featureCard h3 {
  font-size: 16px;
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 6px;
}

.featureCard p {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.6;
  margin: 0;
}

.benefitsSection {
  padding: 60px 0;
  background: #0a0e1a;
}

.benefitsGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px 32px;
  max-width: 800px;
  margin: 30px auto 0;
}

.benefitCard {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  padding: 12px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.03);
}
.benefitCard:last-child {
  border-bottom: none;
}

.benefitIcon {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  background: rgba(0, 255, 100, 0.06);
  border-radius: 50%;
  color: #00ff64;
}

.benefitCard h3 {
  font-size: 15px;
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 2px;
}

.benefitCard p {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.5;
  margin: 0;
}

.ctaSection {
  padding: 80px 0;
  background: #0f1422;
  border-top: 1px solid rgba(255, 255, 255, 0.04);
}

.ctaContent {
  max-width: 640px;
  margin: 0 auto;
  text-align: center;
}

.ctaContent h2 {
  font-size: 36px;
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 14px;
}

.ctaContent p {
  font-size: 17px;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.7;
  margin: 0 0 28px;
}

.ctaBtn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 16px 40px;
  background: #00ff64;
  color: #0a0e1a;
  font-weight: 700;
  font-size: 16px;
  border: none;
  border-radius: 6px;
  text-decoration: none;
  transition: background 0.25s, transform 0.15s;
}
.ctaBtn:hover {
  background: #00e658;
}

@media (max-width: 1024px) {
  .heroTitle { font-size: 40px; }
  .overviewGrid { grid-template-columns: 1fr; gap: 30px; }
  .visualPlaceholder { max-width: 100%; }
  .problemGrid { grid-template-columns: 1fr 1fr; }
  .howGrid, .featuresGrid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 768px) {
  .heroTitle { font-size: 30px; }
  .heroSub { font-size: 16px; }
  .heroStats { gap: 24px; flex-wrap: wrap; }
  .statValue { font-size: 24px; }
  .overviewText h2 { font-size: 28px; }
  .problemGrid { grid-template-columns: 1fr; }
  .deliverablesGrid { grid-template-columns: 1fr; gap: 8px; }
  .howGrid, .featuresGrid { grid-template-columns: 1fr; }
  .benefitsGrid { grid-template-columns: 1fr; gap: 8px; }
  .ctaContent h2 { font-size: 28px; }
  .heroCta { flex-direction: column; align-items: center; }
  .heroBtn, .heroBtnSecondary { width: 100%; justify-content: center; }
  .sectionTitle { font-size: 28px; }
}

@media (max-width: 480px) {
  .heroTitle { font-size: 24px; }
  .container { padding: 0 16px; }
  .heroSection { min-height: auto; padding: 60px 0 40px; }
  .heroStats { flex-direction: column; align-items: center; gap: 12px; }
  .howCard, .featureCard { padding: 20px 16px; }
  .visualPlaceholder { aspect-ratio: 16 / 11; }
}
