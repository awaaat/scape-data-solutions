              className={styles.securityText}
              initial={{ opacity: 0, x: -30 }}
              whileInView={{ opacity: 1, x: 0 }}
              viewport={{ once: false, amount: 0.2 }}
              transition={{ duration: 0.6 }}
            >
              <span className={styles.sectionLabel}>Security & Governance</span>
              <h2>Enterprise‑Grade <span className={styles.highlight}>Data Protection</span></h2>
              <p>
                We take security seriously. Our platform is built with enterprise‑grade features to ensure your data
                is always protected, compliant, and governed.
              </p>
              <ul>
                <li><CheckCircle size={16} /> <strong>Role‑Based Access Control (RBAC)</strong> – define who can see what.</li>
                <li><CheckCircle size={16} /> <strong>Row‑Level Security (RLS)</strong> – filter data based on user attributes.</li>
                <li><CheckCircle size={16} /> <strong>Encryption at Rest & In Transit</strong> – AES‑256 and TLS 1.3.</li>
                <li><CheckCircle size={16} /> <strong>Audit Trails</strong> – track every action for compliance.</li>
                <li><CheckCircle size={16} /> <strong>SSO & SAML 2.0</strong> – integrate with your identity provider.</li>
              </ul>
            </motion.div>
            <motion.div
              className={styles.securityVisual}
              initial={{ opacity: 0, x: 30 }}
              whileInView={{ opacity: 1, x: 0 }}
              viewport={{ once: false, amount: 0.2 }}
              transition={{ duration: 0.6 }}
            >
              <div className={styles.securityBadge}>
                <Shield size={64} />
                <span>SOC2 Type II</span>
                <span>GDPR Compliant</span>
                <span>HIPAA Ready</span>
              </div>
            </motion.div>
          </div>
        </div>
      </section>

      {/* ===== INDUSTRIES WE SERVE ===== */}
      <section className={styles.industriesSection}>
        <div className={styles.container}>
          <motion.h2
            className={styles.sectionTitle}
            initial={{ opacity: 0, y: 20 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: false, amount: 0.2 }}
            transition={{ duration: 0.5 }}
          >
            Industries We <span className={styles.highlight}>Serve</span>
          </motion.h2>
          <div className={styles.industriesGrid}>
            {industries.map((ind, idx) => (
              <motion.div
                key={idx}
                className={styles.industryCard}
                initial={{ opacity: 0, scale: 0.95 }}
                whileInView={{ opacity: 1, scale: 1 }}
                viewport={{ once: false, amount: 0.1 }}
                transition={{ duration: 0.3, delay: idx * 0.03 }}
              >
                {ind}
              </motion.div>
            ))}
          </div>
        </div>
      </section>

      {/* ===== CUSTOMER SUCCESS STORIES ===== */}
      <section className={styles.testimonialsSection}>
        <div className={styles.container}>
          <motion.h2
            className={styles.sectionTitle}
            initial={{ opacity: 0, y: 20 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: false, amount: 0.2 }}
            transition={{ duration: 0.5 }}
          >
            What Our <span className={styles.highlight}>Customers</span> Say
          </motion.h2>
          <div className={styles.testimonialsGrid}>
            {testimonials.map((t, idx) => (
              <motion.div
                key={idx}
                className={styles.testimonialCard}
                initial={{ opacity: 0, scale: 0.95 }}
                whileInView={{ opacity: 1, scale: 1 }}
                viewport={{ once: false, amount: 0.2 }}
                transition={{ duration: 0.4 }}
              >
                <div className={styles.quoteIcon}>“</div>
                <p>{t.quote}</p>
                <div className={styles.author}>
                  <strong>{t.author}</strong>
                  <span>{t.role}, {t.company}</span>
                </div>
              </motion.div>
            ))}
          </div>
        </div>
      </section>

      {/* ===== FAQ ===== */}
      <section className={styles.faqSection}>
        <div className={styles.container}>
          <motion.h2
            className={styles.sectionTitle}
            initial={{ opacity: 0, y: 20 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: false, amount: 0.2 }}
            transition={{ duration: 0.5 }}
          >
            Frequently Asked <span className={styles.highlight}>Questions</span>
          </motion.h2>
          <div className={styles.faqGrid}>
            {faqs.map((faq, idx) => (
              <AccordionItem
                key={idx}
                title={faq.q}
                content={<p>{faq.a}</p>}
                isOpen={openFaq === idx}
                onClick={() => setOpenFaq(openFaq === idx ? null : idx)}
              />
            ))}
          </div>
        </div>
      </section>

      {/* ===== RESOURCES (blog & whitepapers) ===== */}
      <section className={styles.resourcesSection}>
        <div className={styles.container}>
          <motion.h2
            className={styles.sectionTitle}
            initial={{ opacity: 0, y: 20 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: false, amount: 0.2 }}
            transition={{ duration: 0.5 }}
          >
            Latest <span className={styles.highlight}>Resources</span>
          </motion.h2>
          <div className={styles.resourcesGrid}>
            {resources.map((res, idx) => (
              <motion.div
                key={idx}
                className={styles.resourceCard}
                initial={{ opacity: 0, y: 20 }}
                whileInView={{ opacity: 1, y: 0 }}
                viewport={{ once: false, amount: 0.1 }}
                transition={{ duration: 0.4, delay: idx * 0.1 }}
              >
                <div className={styles.resourceType}>{res.type}</div>
                <h3>{res.title}</h3>
                <div className={styles.resourceDate}>{res.date}</div>
                <Link to="#" className={styles.resourceLink}>Read More →</Link>
              </motion.div>
            ))}
          </div>
        </div>
      </section>

      {/* ===== CTA – no pricing ===== */}
      <section className={styles.ctaSection}>
        <div className={styles.container}>
          <motion.div
            className={styles.ctaContent}
            initial={{ opacity: 0, y: 20 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: false, amount: 0.2 }}
            transition={{ duration: 0.6 }}
          >
            <h2>Ready to Transform Your Business Intelligence?</h2>
            <p>
              Join thousands of companies that have turned their data into a competitive advantage.
              Start your free trial today – no credit card required.
            </p>
            <div className={styles.ctaButtons}>
              <motion.div whileHover={{ scale: 1.04 }} whileTap={{ scale: 0.96 }}>
                <Link to="/contact" className={styles.ctaBtn}>
                  Start Free Trial <ArrowRight size={18} />
                </Link>
              </motion.div>
              <motion.div whileHover={{ scale: 1.04 }} whileTap={{ scale: 0.96 }}>
                <a href="#" className={styles.ctaBtnSecondary}>
                  <Mail size={18} /> Contact Sales
                </a>
              </motion.div>
            </div>
            <p className={styles.ctaFinePrint}>14‑day trial, full access, no commitment.</p>
          </motion.div>
        </div>
      </section>
    </PageLayout>
  );
};

export default BusinessIntelligencePage;