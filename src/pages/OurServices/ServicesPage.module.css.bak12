/* ============================================================
   ServicesPage.module.css — Minimal, no‑frills
   Black & white, one accent (#fdb840) only for titles
   NO HOVER EFFECTS on buttons. Cards smaller, striped.
   Background image for cards section – NO OVERLAY.
   Added sticky sidebar with distinct styling.
   ============================================================ */

/* ---------- Particles ---------- */
.particlesContainer {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}
.particle {
  position: absolute;
  background: #fdb840;
  opacity: 0.06;
}

/* ---------- Hero ---------- */
.heroSection {
  position: relative;
  min-height: 60vh;
  background: #1a1a2e;
  display: flex;
  align-items: center;
  padding: 70px 0 50px;
  overflow: hidden;
}
.heroGradient {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 0;
}
.heroShapes {
  display: none;
}

.heroContent {
  max-width: 860px;
  margin: 0 auto;
  padding: 0 30px;
  position: relative;
  z-index: 1;
  text-align: center;
}
.heroBadge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(253, 184, 64, 0.1);
  color: #fdb840;
  padding: 4px 14px;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 12px;
}
.heroTitle {
  font-size: 44px;
  font-weight: 700;
  line-height: 1.15;
  margin: 0 0 12px;
  color: #ffffff;
}
.highlight {
  color: #fdb840;
}
.heroSub {
  font-size: 17px;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 24px;
  line-height: 1.7;
  max-width: 620px;
  margin-left: auto;
  margin-right: auto;
}
.heroStats {
  display: flex;
  justify-content: center;
  gap: 36px;
  margin-bottom: 28px;
  flex-wrap: wrap;
}
.statItem {
  text-align: center;
}
.statValue {
  font-size: 28px;
  font-weight: 800;
  color: #fdb840;
}
.statLabel {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.6);
  text-transform: uppercase;
  letter-spacing: 0.4px;
}
.heroCta {
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
}
.heroBtn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 13px 30px;
  border: 2px solid #fdb840;
  background: #fdb840;
  color: #1a1a2e;
  font-weight: 700;
  font-size: 14px;
  text-decoration: none;
  cursor: pointer;
}
.heroBtn:hover {
  background: transparent;
  color: #fdb840;
}
.heroBtnSecondary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 13px 26px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  background: transparent;
  color: #fff;
  font-weight: 600;
  font-size: 14px;
  text-decoration: none;
}
.heroBtnSecondary:hover {
  border-color: #fff;
}

/* ---------- Live Stats Panel ---------- */
.liveStatsPanel {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  padding: 18px 24px;
  margin-top: 32px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  position: relative;
  z-index: 1;
}
.liveStatCell {
  text-align: center;
}
.liveStatHead {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 0.4px;
  margin-bottom: 4px;
}
.liveStatVal {
  font-size: 22px;
  font-weight: 800;
  color: #fdb840;
}

/* ---------- Intro Section ---------- */
.introSection {
  padding: 50px 0;
  background: #ffffff;
}
.introGrid {
  display: grid;
  grid-template-columns: 1.3fr 1fr;
  gap: 44px;
  align-items: start;
}
.introText {
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.introPara {
  font-size: 15px;
  color: #333;
  line-height: 1.8;
  margin: 0;
}
.introPara strong {
  color: #fdb840;
}
.introPanel {
  background: #f8f9fc;
  border: 1px solid #eee;
  padding: 22px 26px;
}
.ipHeader {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #888;
  margin-bottom: 14px;
}
.metricRow {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 9px;
}
.metricLabel {
  font-size: 12.5px;
  color: #444;
  width: 130px;
  flex-shrink: 0;
}
.metricBar {
  flex: 1;
  height: 4px;
  background: #e8e8e8;
  overflow: hidden;
}
.metricFill {
  height: 100%;
  background: #fdb840;
}
.metricVal {
  font-size: 12.5px;
  font-weight: 600;
  color: #1a1a2e;
  width: 32px;
  text-align: right;
}

/* ---------- Filter Section ---------- */
.filterSection {
  padding: 40px 0 34px;
  background: #f8f9fc;
  border-top: 1px solid #e8e8e8;
  border-bottom: 1px solid #e8e8e8;
}
.filterTitle {
  font-size: 28px;
  font-weight: 700;
  color: #1a1a2e;
  text-align: center;
  margin-bottom: 20px;
}

/* ---------- Filter Layout: Sidebar (distinct) + Cards ---------- */
.filterLayout {
  display: flex;
  gap: 2rem;
  align-items: flex-start;
}

/* Sidebar – clearly different background, with border/shadow */
.filterSidebar {
  flex: 0 0 220px;
  min-width: 180px;
  position: sticky;
  top: 100px;
  align-self: flex-start;
  max-height: calc(100vh - 120px);
  overflow-y: auto;
  background: #eef1f5;
  border: 1px solid #d0d7de;
  border-radius: 0px;
  padding: 1rem 0;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.sidebarList {
  list-style: none;
  padding: 0;
  margin: 0;
}
.sidebarList li {
  margin-bottom: 0.25rem;
}

.sidebarBtn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
  padding: 0.6rem 1.2rem;
  border: none;
  background: transparent;
  color: #2c3e50;
  font-size: 0.95rem;
  font-weight: 500;
  cursor: pointer;
  transition: background 0.15s, color 0.15s;
  border-radius: 0;
  font-family: inherit;
  text-align: left;
}
.sidebarBtn:hover {
  background: rgba(253, 184, 64, 0.12);
}
.sidebarBtn.active {
  background: #fdb840;
  color: #1a1a2e;
  font-weight: 600;
  border-left: 4px solid #1a1a2e;
}

.filterCards {
  flex: 1;
}

/* ---------- Services Grid ---------- */
.servicesSection {
  padding: 50px 0;
  position: relative;
  background: #ffffff;
  background-image: url('/Images/site-images/ai-i.avif');
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
}

.cardsGrid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
  max-width: 780px;
  margin: 0 auto;
  padding: 0 16px;
  position: relative;
  z-index: 1;
}

/* --- Card --- */
.card {
  background: #ffffff;
  border: 1px solid #eee;
  overflow: hidden;
  cursor: default;
  display: flex;
  flex-direction: column;
  max-width: 360px;
  margin: 0 auto;
  width: 100%;
}

/* Striped background: every pair of cards gets a light grey */
.card:nth-child(4n+1),
.card:nth-child(4n+2) {
  background: #f8f8f8;
}
.card:nth-child(4n+3),
.card:nth-child(4n+4) {
  background: #ffffff;
}

.cardIconWrap {
  display: none;
}

/* --- Card Body --- */
.cardBody {
  padding: 18px 18px 18px;
  display: flex;
  flex-direction: column;
  flex: 1;
}
.cardTitle {
  font-size: 17px;
  font-weight: 700;
  margin: 0 0 6px;
  line-height: 1.3;
}
.cardTitle a {
  color: #1a1a2e;
  text-decoration: none;
}
.cardTitle a:hover {
  color: #fdb840;
}
.cardDescription {
  font-size: 13px;
  color: #666;
  line-height: 1.6;
  margin-bottom: 12px;
}

/* --- Metrics chips --- */
.cardMetrics {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  margin-bottom: 12px;
}
.cardMetricChip {
  font-size: 10px;
  font-weight: 600;
  padding: 3px 12px;
  background: #f5f5f5;
  color: #444;
  border: 1px solid #eee;
}
.cardMetricChip:first-child {
  background: #1a1a2e;
  border-color: #1a1a2e;
  color: #ffffff;
}

/* --- Bullet list --- */
.cardList {
  list-style: none;
  padding: 0;
  margin: 0 0 14px;
  flex: 1;
}
.cardListItem {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 0;
  font-size: 13px;
  color: #444;
  border-bottom: 1px solid #f0f0f0;
}
.cardListItem:last-child {
  border-bottom: none;
}
.cardListItem a {
  color: inherit;
  text-decoration: none;
}
.cardListItem a:hover {
  color: #fdb840;
}
.arrowIcon {
  width: 10px;
  height: 10px;
  object-fit: contain;
  opacity: 0.3;
  flex-shrink: 0;
}
.moreItems {
  color: #999;
  font-style: italic;
  font-size: 11px;
  padding: 2px 0;
}

/* --- Learn More button — NO HOVER EFFECTS AT ALL --- */
.cardBtn {
  width: 100%;
  padding: 10px 0;
  background: transparent;
  border: 2px solid #1a1a2e;
  font-weight: 700;
  font-size: 12px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  font-family: inherit;
  color: #1a1a2e;
  margin-top: 4px;
}
.cardBtn:hover,
.cardBtn:focus,
.cardBtn:active {
  background: transparent;
  border-color: #1a1a2e;
  color: #1a1a2e;
  transform: none;
  box-shadow: none;
}

/* ---------- CTA Strip ---------- */
.ctaStrip {
  background: #1a1a2e;
  padding: 28px 0;
  text-align: center;
}
.ctaText {
  font-size: 17px;
  color: #ffffff;
  margin: 0;
}
.ctaText a {
  color: #fdb840;
  font-weight: 700;
  text-decoration: underline;
}
.ctaText a:hover {
  color: #fff;
}

/* ---------- Modal ---------- */
.modal {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
  padding: 20px;
}
.modalContent {
  background: #ffffff;
  max-width: 620px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  position: relative;
  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.15);
}
.modalClose {
  position: absolute;
  top: 12px;
  right: 16px;
  background: rgba(0, 0, 0, 0.04);
  border: none;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 10;
  color: #1a1a2e;
}
.modalClose:hover {
  background: #1a1a2e;
  color: #ffffff;
}
.modalHeader {
  padding: 24px 24px 14px;
  text-align: center;
  border-bottom: 3px solid #fdb840;
}
.modalIcon {
  display: none;
}
.modalHeader h2 {
  font-size: 23px;
  font-weight: 700;
  margin: 0 0 4px;
  color: #1a1a2e;
}
.modalHeader p {
  font-size: 13px;
  color: #888;
  margin: 0;
}
.modalImage {
  display: none;
}
.modalBody {
  padding: 14px 24px 24px;
}
.modalDescription {
  font-size: 14px;
  line-height: 1.7;
  color: #555;
}
.modalMetrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin: 16px 0;
}
.modalMetric {
  text-align: center;
  background: #f8f9fc;
  padding: 12px 4px;
  border: 1px solid #eee;
}
.modalMetricValue {
  font-size: 19px;
  font-weight: 700;
  color: #1a1a2e;
}
.modalMetricLabel {
  font-size: 9px;
  text-transform: uppercase;
  color: #888;
  letter-spacing: 0.3px;
}
.modalBody h3 {
  font-size: 16px;
  font-weight: 700;
  color: #1a1a2e;
  margin: 16px 0 8px;
}
.modalFeatures {
  list-style: none;
  padding: 0;
  margin: 0 0 16px;
}
.modalFeatures li {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 0;
  border-bottom: 1px solid #f1f5f9;
  font-size: 13px;
  color: #555;
}
.modalFeatures li:last-child {
  border-bottom: none;
}
.modalFeatures li svg {
  color: #fdb840;
  flex-shrink: 0;
}
.modalBtn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 12px 28px;
  border: 2px solid #1a1a2e;
  background: #1a1a2e;
  font-weight: 700;
  font-size: 13px;
  text-decoration: none;
  color: #ffffff;
}
.modalBtn:hover {
  background: transparent;
  color: #1a1a2e;
}

.modalContent::-webkit-scrollbar {
  width: 6px;
}
.modalContent::-webkit-scrollbar-track {
  background: #f1f5f9;
}
.modalContent::-webkit-scrollbar-thumb {
  background: #cbd5e1;
}
.modalContent::-webkit-scrollbar-thumb:hover {
  background: #1a1a2e;
}

/* ---------- Payment Strip (navy footer) ---------- */
.navyPayStrip {
  padding: 20px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  background: #0d2b6b;
}
.navyPayInner {
  display: flex;
  align-items: center;
  gap: 20px;
  overflow: hidden;
}
.navyPayLabel {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.5);
  white-space: nowrap;
}
.navyPayScroll {
  overflow: hidden;
  flex: 1;
}
.navyPayTrack {
  display: flex;
  gap: 20px;
  align-items: center;
  animation: navyPayScroll 28s linear infinite;
}
.navyPayTrack:hover {
  animation-play-state: paused;
}
@keyframes navyPayScroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
.navyPayItem {
  display: inline-block;
}
.navyPayItem img {
  height: 28px;
  width: auto;
  object-fit: contain;
  opacity: 0.7;
  filter: brightness(0) invert(1);
}
.navyPayItem:hover img {
  opacity: 1;
  filter: none;
}

/* ---------- Responsive ---------- */
@media (max-width: 1024px) {
  .heroTitle {
    font-size: 34px;
  }
  .introGrid {
    grid-template-columns: 1fr;
  }
  .cardsGrid {
    grid-template-columns: repeat(2, 1fr);
    max-width: 100%;
  }
  .liveStatsPanel {
    grid-template-columns: repeat(2, 1fr);
  }
  .servicesSection {
    background-attachment: scroll;
  }
}
@media (max-width: 768px) {
  .heroTitle {
    font-size: 26px;
  }
  .heroStats {
    gap: 18px;
  }
  .cardsGrid {
    grid-template-columns: 1fr;
    max-width: 100%;
    padding: 0 16px;
  }
  .card {
    max-width: 100%;
  }
  .filterTitle {
    font-size: 22px;
  }
  .filterLayout {
    flex-direction: column;
  }
  .filterSidebar {
    flex: none;
    width: 100%;
    position: static;
    max-height: none;
    overflow-y: visible;
    background: transparent;
    border: none;
    box-shadow: none;
    padding: 0;
    border-radius: 0;
  }
  .sidebarList {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .sidebarList li {
    flex: 0 0 auto;
    margin-bottom: 0;
  }
  .sidebarBtn {
    padding: 0.4rem 0.8rem;
    font-size: 0.85rem;
    border-radius: 4px;
    background: #eef1f5;
    width: auto;
    border: 1px solid #d0d7de;
  }
  .sidebarBtn.active {
    background: #fdb840;
    border-left: none;
  }
  .navyPayInner {
    gap: 12px;
  }
  .navyPayLabel {
    font-size: 10px;
  }
  .navyPayItem img {
    height: 22px;
  }
  .navyPayTrack {
    gap: 14px;
  }
}
@media (max-width: 480px) {
  .heroTitle {
    font-size: 22px;
  }
  .heroStats {
    flex-direction: column;
    gap: 8px;
  }
  .heroCta {
    flex-direction: column;
    align-items: center;
  }
  .heroBtn,
  .heroBtnSecondary {
    width: 100%;
    justify-content: center;
  }
  .modalContent {
    max-width: 95%;
  }
  .liveStatsPanel {
    grid-template-columns: 1fr 1fr;
  }
}

/* ---------- Detail Page ---------- */
.detailSection {
  padding: 80px 0 60px;
  background: #ffffff;
  min-height: 60vh;
}
.detailContent {
  max-width: 800px;
  margin: 0 auto;
  padding: 0 20px;
}
.backBtn {
  background: none;
  border: none;
  color: #fdb840;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  padding: 0;
  margin-bottom: 24px;
  transition: color 0.2s;
}
.backBtn:hover {
  color: #1a1a2e;
}
.detailTitle {
  font-size: 38px;
  font-weight: 700;
  color: #1a1a2e;
  margin: 0 0 8px;
}
.detailTagline {
  font-size: 18px;
  color: #666;
  margin-bottom: 24px;
}
.detailMetrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin: 24px 0;
}
.detailMetric {
  background: #f8f9fc;
  border: 1px solid #eee;
  padding: 16px;
  text-align: center;
}
.detailMetricValue {
  display: block;
  font-size: 24px;
  font-weight: 700;
  color: #fdb840;
}
.detailMetricLabel {
  font-size: 11px;
  text-transform: uppercase;
  color: #888;
  letter-spacing: 0.5px;
}
.detailDescription {
  font-size: 16px;
  line-height: 1.8;
  color: #555;
  margin: 24px 0;
}
.detailSubtitle {
  font-size: 20px;
  font-weight: 700;
  color: #1a1a2e;
  margin: 32px 0 16px;
}
.detailFeatures {
  list-style: none;
  padding: 0;
  margin: 0 0 32px;
}
.detailFeatures li {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 0;
  border-bottom: 1px solid #f1f5f9;
  font-size: 15px;
  color: #444;
}
.detailFeatures li:last-child {
  border-bottom: none;
}
.detailCta {
  margin-top: 32px;
}
.detailBtn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 32px;
  background: #fdb840;
  color: #1a1a2e;
  font-weight: 700;
  font-size: 15px;
  text-decoration: none;
  border-radius: 4px;
  transition: all 0.3s;
}
.detailBtn:hover {
  background: #1a1a2e;
  color: #fff;
}
.cardBtnLink {
  display: block;
  text-decoration: none;
}