            <div className={styles.visualInline}>
              <ScatterPlot />
              <p className={styles.visualCaption}>Figure 2: Scatter plot with regression line – visualizing relationships</p>
            </div>
          </ScrollReveal>
        </div>
      </section>

      {/* ─── SERVICES ────────────────────────────────────────────── */}
      <section className={styles.servicesSection}>
        <div className={styles.container}>
          <ScrollReveal direction="up" delay={0.1}>
            <h2 className={styles.sectionTitle}>Services</h2>
          </ScrollReveal>
          <div className={styles.servicesGrid}>
            {SERVICES.map((s, i) => (
              <ScrollReveal key={i} direction="up" delay={0.05 + i * 0.05}>
                <div className={styles.serviceCard}>
                  <div className={styles.serviceHex}>
                    <div className={styles.serviceHexInner}>{s.icon}</div>
                  </div>
                  <h5>{s.title}</h5>
                  <p>{s.desc}</p>
                </div>
              </ScrollReveal>
            ))}
          </div>
          {/* ─── VISUAL 3: Fit Indices ────────────────────── */}
          <ScrollReveal direction="up" delay={0.1}>
            <div className={styles.visualInline}>
              <FitIndicesBarChart />
              <p className={styles.visualCaption}>Figure 3: Common model fit indices – CFI, TLI, RMSEA, SRMR</p>
            </div>
          </ScrollReveal>
        </div>
      </section>

      {/* ─── WHY CHOOSE US ────────────────────────────────────────── */}
      <section className={styles.whySection}>
        <div className={styles.container}>
          <ScrollReveal direction="up" delay={0.1}>
            <h2 className={styles.sectionTitle}>Why Choose Us</h2>
          </ScrollReveal>
          <div className={styles.whyGrid}>
            {WHY_US.map((item, i) => (
              <ScrollReveal key={i} direction="up" delay={0.05 + i * 0.05}>
                <div className={styles.whyCard}>
                  <div className={styles.whyIcon}>{item.icon}</div>
                  <h3>{item.title}</h3>
                  <p>{item.desc}</p>
                </div>
              </ScrollReveal>
            ))}
          </div>
          {/* ─── VISUAL 4: Correlation Heatmap ────────────── */}
          <ScrollReveal direction="up" delay={0.1}>
            <div className={styles.visualInline}>
              <CorrelationHeatmap />
              <p className={styles.visualCaption}>Figure 4: Correlation matrix – understanding variable relationships</p>
            </div>
          </ScrollReveal>
        </div>
      </section>

      {/* ─── CTA RIBBON 2 ────────────────────────────────────────── */}
      <section className={styles.ribbonSection}>
        <div className={styles.container}>
          <div className={styles.ribbon}>
            <h2>Struggling with SEM in AMOS, R-Studio, or STATA?</h2>
            <Link to="/contact" className={styles.ribbonBtn}>
              Get Help Now <ArrowRight size={13} />
            </Link>
          </div>
        </div>
      </section>

      {/* ─── STATS ────────────────────────────────────────────────── */}
      <section className={styles.statsSection}>
        <div className={styles.container}>
          <ScrollReveal direction="up" delay={0.1}>
            <div className={styles.statsHeading}>
              <CheckCircle2 size={40} className={styles.statsHeadingIcon} />
              <h2>Doing the right thing,<br />at the right time.</h2>
            </div>
          </ScrollReveal>
          <div className={styles.statsGrid}>
            {STATS.map((s, i) => (
              <ScrollReveal key={i} direction="up" delay={0.06 + i * 0.06}>
                <div className={styles.statCard}>
                  <div className={styles.statValue}>
                    <CountUp end={s.value} suffix={s.suffix || ""} />
                  </div>
                  <div className={styles.statLabel}>{s.label}</div>
                </div>
              </ScrollReveal>
            ))}
          </div>
        </div>
      </section>

      {/* ─── TESTIMONIALS ────────────────────────────────────────── */}
      <section className={styles.testimonialsSection}>
        <div className={styles.container}>
          <ScrollReveal direction="up" delay={0.1}>
            <h2 className={styles.sectionTitle}>Testimonials</h2>
          </ScrollReveal>
          <div className={styles.testimonialsRow}>
            <button className={styles.testimonialNav} onClick={prevTestimonial} aria-label="Previous testimonials">
              <ChevronLeft size={18} />
            </button>
            <div className={styles.testimonialsGrid}>
              {visibleTestimonials.map((t, i) => (
                <div className={styles.testimonialCard} key={i}>
                  <p className={styles.testimonialQuote}>&ldquo;{t.quote}&rdquo;</p>
                  <div className={styles.testimonialAuthor}>
                    <div className={styles.testimonialAvatar}>{t.initials}</div>
                    <div>
                      <div className={styles.testimonialName}>{t.name}</div>
                      <div className={styles.testimonialRole}>{t.role}</div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
            <button className={styles.testimonialNav} onClick={nextTestimonial} aria-label="Next testimonials">
              <ChevronRight size={18} />
            </button>
          </div>
          {/* ─── VISUAL 5: Factor Loadings ────────────────── */}
          <ScrollReveal direction="up" delay={0.1}>
            <div className={styles.visualInline}>
              <FactorLoadingsPlot />
              <p className={styles.visualCaption}>Figure 5: Factor loadings plot – assessing measurement model quality</p>  
            </div>
          </ScrollReveal>
        </div>
      </section>

      {/* ─── FAQ ───────────────────────────────────────────────────── */}
      <section className={styles.faqSection}>
        <div className={styles.container}>
          <ScrollReveal direction="up" delay={0.1}>
            <h2 className={styles.sectionTitle}>Frequently Asked Questions</h2>
          </ScrollReveal>
          <div className={styles.faqGrid}>
            {FAQS.map((faq, i) => (
              <ScrollReveal key={i} direction="up" delay={0.05 + i * 0.05}>
                <FAQItem
                  faq={faq}
                  isOpen={openFaq === i}
                  onToggle={() => toggleFaq(i)}
                />
              </ScrollReveal>
            ))}
          </div>
        </div>
      </section>

      {/* ─── NEWS ────────────────────────────────────────────────── */}
      <section className={styles.newsSection}>
        <div className={styles.container}>
          <ScrollReveal direction="up" delay={0.1}>
            <h2 className={styles.sectionTitle}>News</h2>
          </ScrollReveal>
          <div className={styles.newsGrid}>
            {ARTICLES.map((a, i) => (
              <ScrollReveal key={i} direction="up" delay={0.05 + i * 0.05}>
                <div className={styles.newsCard}>
                  <div className={styles.newsBody}>
                    <h5>
                      <a 
                        href={a.link} 
                        target="_blank" 
                        rel="noopener noreferrer" 
                        className={styles.newsLink}
                      >
                        {a.title}
                      </a>
                    </h5>
                    <p className={styles.newsExcerpt}>{a.excerpt}</p>
                    <span className={styles.newsDate}>{a.date}</span>
                  </div>
                </div>
              </ScrollReveal>
            ))}
          </div>
        </div>
      </section>

      {/* ─── FINAL CTA ───────────────────────────────────────────── */}
      <section className={styles.finalCtaSection}>
        <div className={styles.container}>
          <ScrollReveal direction="up" delay={0.1}>
            <div className={styles.finalCta}>
              <h2>Seeking the Best AMOS &amp; SEM Help for Your Dissertation?</h2>
              <p>Get your free quote now — expect a prompt response by email within 5 minutes.</p>
              <Link to="/contact" className={styles.finalCtaBtn}>
                Get a Free Quote Today! <ArrowRight size={14} />
              </Link>
            </div>
          </ScrollReveal>
        </div>
      </section>

      {/* ─── LONG-FORM COPY ──────────────────────────────────────── */}
      <section className={styles.aboutSection}>
        <div className={styles.container}>
          <ScrollReveal direction="up" delay={0.1}>
            <h3 className={styles.aboutTitle}>Empowering Your Academic Success</h3>
            <div className={styles.aboutBody}>
              <p>
                Welcome — we provide expert AMOS and structural equation modeling help for
                dissertations, theses, and research papers. If you're a student, researcher, or
                PhD candidate working through a measurement or structural model, you're in the
                right place. Our statisticians support Master's, Doctoral, and PhD students, as
                well as working professionals, with their SEM needs.
              </p>
              <p>
                Simply submit your task through "Get a Free Quote," and our team takes it from
                there — methodology, hypotheses, model specification, analysis, and results
                interpretation, all included. We work across AMOS, SPSS, R-Studio, STATA, and
                Mplus, whichever your program requires.
              </p>
              <p>
                We're your partners for dissertation SEM support and biostatistical modeling,
                with experience extending into medical and healthcare research. Whatever stage
                your model is at, our support is built around getting it to a defensible fit.
              </p>
              <h4>Here's how it works:</h4>
              <ol>
                <li><strong>Submit your model</strong> — share your project details and we'll review your requirements.</li>
                <li><strong>Get a free quote</strong> — a transparent, no-obligation price with no hidden costs.</li>
                <li><strong>Expert analysis begins</strong> — once approved, our statisticians get to work on accurate, reliable results.</li>
                <li><strong>Timely delivery</strong> — delivered on schedule, with time left for your own review.</li>
                <li><strong>Ongoing support</strong> — our team is here for questions throughout the process.</li>
              </ol>
            </div>
          </ScrollReveal>
        </div>
      </section>

      <AnimatePresence>
        {showTop && (
          <motion.button
            className={styles.scrollTop}
            onClick={() => window.scrollTo({ top: 0, behavior: "smooth" })}
            initial={{ opacity: 0, scale: 0.5, y: 20 }}
            animate={{ opacity: 1, scale: 1, y: 0 }}
            exit={{ opacity: 0, scale: 0.5, y: 20 }}
            whileHover={{ scale: 1.08 }}
          >
            <ChevronUp size={18} />
          </motion.button>
        )}
      </AnimatePresence>
    </PageLayout>
  );
};

export default AMOSSEMAnalysisPage;