      const yPos = 230 - barHeight;
      return (
        <g key={i}>
          <rect x={xPos} y={yPos} width="30" height={barHeight} fill={item.color} rx="4" />
          <text x={xPos + 15} y="240" textAnchor="middle" fontSize="10" fill="#333">{item.label}</text>
          <text x={xPos + 15} y={yPos - 6} textAnchor="middle" fontSize="9" fill="#333">{item.value.toFixed(2)}</text>
        </g>
      );
    })}
    <text x="200" y="270" textAnchor="middle" fontSize="11" fill="#666">Figure: Model Fit Indices</text>
  </motion.svg>
);

