        const color = val > 0.7 ? "#002e5b" : val > 0.5 ? "#fde428" : "#e0e0e0";
        return (
          <rect key={`${i}-${j}`} x={x} y={y} width="55" height="40" rx="4" fill={color}>
            <text x={x + 27} y={y + 25} textAnchor="middle" fontSize="12" fill="#fff" fontWeight="bold">{val}</text>
          </rect>
        );
      })
    ))}
    <text x="60" y="40" fontSize="11" fill="#333">V1</text>
    <text x="140" y="40" fontSize="11" fill="#333">V2</text>
    <text x="220" y="40" fontSize="11" fill="#333">V3</text>
