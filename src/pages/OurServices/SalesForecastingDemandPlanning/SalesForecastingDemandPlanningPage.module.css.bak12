/* ═══════════════════════════════════════════════════════════════
   DESIGN TOKENS — matched 1:1 to the Campfire.ai visual system
   (colors, radii, spacing rhythm, button mechanics, type scale)
   ═══════════════════════════════════════════════════════════════ */
:global(:root) {
  --white: #F9F9F8;
  --purewhite: #FFFFFF;
  --pureblack: #000000;
  --charcoal700: #101012;
  --charcoal500: #535353;
  --charcoal300: #9B9B9B;
  --charcoal200: #D2D2D2;

  --greenblack: #111816;
  --greendark01: #142D25;
  --greendark02: #0A4733;
  --greengray01: #52644D;
  --greengray02: #869C80;
  --greenpastel01: #DAECDE;
  --greenpastel02: #ECF6EF;
  --greensaturated01: #8BEC5C;
  --greensaturated02: #B3ED97;

  --orangedark01: #301805;
  --orangedark02: #5B2B04;
  --orangegray01: #8A6240;
  --orangegray02: #B09278;
  --orangesaturated01: #FF862F;
  --orangesaturated02: #F7A061;
  --orangepastel01: #EEE4D8;
  --orangepastel02: #F9F4EE;

  --font-display: 'Manrope', sans-serif;
}

/* ─── CONTAINER ───────────────────────────────────────────────── */
.container {
  max-width: 1220px;
  margin: 0 auto;
  padding: 0 50px;
}

@media (max-width: 992px) {
  .container { padding: 0 30px; }
}

@media (max-width: 600px) {
  .container { padding: 0 17px; }
}

.highlight {
  color: var(--orangesaturated01);
}

/* ═══════════════════════════════════════════════════════════════
   HERO — dark green field, radial orange glow, pill CTAs
   ═══════════════════════════════════════════════════════════════ */
.heroSection {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  background-color: var(--greendark01);
  padding: 110px 0 60px;
}

.heroOverlay {
  position: absolute;
  inset: 0;
  background-image: radial-gradient(
    ellipse 80% 80% at 70% 20%,
    rgba(255, 134, 47, 0.14) 0%,
    rgba(255, 134, 47, 0) 100%
  );
  z-index: 0;
}

.heroBlobOne,
.heroBlobTwo {
  position: absolute;
  border-radius: 50%;
  filter: blur(90px);
  z-index: 0;
  pointer-events: none;
}

.heroBlobOne {
  width: 420px;
  height: 420px;
  background: rgba(255, 134, 47, 0.16);
  top: 8%;
  right: 6%;
}

.heroBlobTwo {
  width: 320px;
  height: 320px;
  background: rgba(139, 236, 92, 0.12);
  bottom: 6%;
  left: 14%;
}

.heroSection .container {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  gap: 60px;
  align-items: center;
  width: 100%;
}

.heroContent { color: var(--white); }

.heroBadge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--greenpastel02);
  color: var(--greenblack);
  padding: 8px 20px 8px 12px;
  border-radius: 130px;
  font-family: var(--font-display);
  font-size: 0.8rem;
  font-weight: 500;
  letter-spacing: -0.01em;
  margin-bottom: 24px;
}

.liveDot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--greensaturated01);
  display: inline-block;
}

.heroTitle {
  font-family: var(--font-display);
  font-size: clamp(2.4rem, 5vw, 4rem);
  font-weight: 400;
  line-height: 1.05;
  letter-spacing: -0.03em;
  color: var(--white);
  margin-bottom: 20px;
  text-wrap: balance;
}

.heroTitle .highlight {
  color: var(--orangesaturated01);
}

.heroSub {
  font-family: var(--font-display);
  font-size: 1.1rem;
  line-height: 1.5;
  color: var(--greengray02);
  margin-bottom: 32px;
  max-width: 560px;
}

.heroCta {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 48px;
}

/* Pill buttons with the layered-circle hover mechanism */
.heroBtn,
.heroBtnSecondary,
.ctaBtn {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 16px 24px;
  border-radius: 99vw;
  font-family: var(--font-display);
  font-weight: 400;
  font-size: 0.9rem;
  text-decoration: none;
  overflow: hidden;
  isolation: isolate;
  cursor: pointer;
  transition: color 0.3s cubic-bezier(0.7, 0, 0.38, 1);
}

.heroBtn::before,
.heroBtn::after,
.ctaBtn::before,
.ctaBtn::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 99vw;
  z-index: -1;
  transition: transform 0.4s cubic-bezier(0.7, 0, 0.38, 1);
}

.heroBtn,
.ctaBtn {
  color: var(--white);
  background: var(--orangesaturated01);
}

.heroBtn::before,
.ctaBtn::before {
  background: var(--orangesaturated02);
  transform: scale(0);
  transform-origin: center;
}

.heroBtn:hover::before,
.ctaBtn:hover::before {
  transform: scale(1.15);
}

.heroBtnSecondary {
  color: var(--white);
  background: transparent;
  border: 1px solid rgba(249, 249, 248, 0.25);
}

.heroBtnSecondary:hover {
  background: rgba(249, 249, 248, 0.08);
  border-color: var(--white);
}

.heroStats {
  display: flex;
  gap: 50px;
  padding-top: 28px;
  border-top: 0.99px solid rgba(210, 210, 210, 0.2);
}

.counterItem { display: flex; flex-direction: column; gap: 2px; }

.counterValue {
  font-family: var(--font-display);
  font-size: 2rem;
  font-weight: 500;
  color: var(--greensaturated02);
  letter-spacing: -0.02em;
  line-height: 1.1;
}

.counterLabel {
  font-family: var(--font-display);
  font-size: 0.8rem;
  color: var(--greengray02);
}

.heroImage {
  display: flex;
  justify-content: center;
  align-items: center;
}

.heroImage img {
  width: 100%;
  max-width: 580px;
  border-radius: 20px;
  box-shadow: 0 24px 64px rgba(0, 0, 0, 0.35);
  display: block;
}

@media (max-width: 992px) {
  .heroSection .container { grid-template-columns: 1fr; text-align: center; gap: 40px; }
  .heroSub { max-width: 100%; margin-left: auto; margin-right: auto; }
  .heroStats { justify-content: center; }
  .heroCta { justify-content: center; }
  .heroImage img { max-width: 420px; }
}

@media (max-width: 600px) {
  .heroStats { gap: 24px; flex-wrap: wrap; }
  .counterValue { font-size: 1.5rem; }
  .heroSection { min-height: auto; padding: 80px 0 40px; }
}

/* ═══════════════════════════════════════════════════════════════
   LOGO STRIP
   ═══════════════════════════════════════════════════════════════ */
.logoStrip {
  padding: 40px 0;
  background: var(--white);
  text-align: center;
}

.logoStripLabel {
  font-family: var(--font-display);
  font-size: 0.75rem;
  color: var(--charcoal500);
  margin-bottom: 20px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-weight: 500;
}

.logoGrid {
  display: flex;
  justify-content: center;
  gap: 40px;
  flex-wrap: wrap;
}

.logoGrid span {
  font-family: var(--font-display);
  font-size: 1.05rem;
  font-weight: 500;
  color: var(--greendark01);
  opacity: 0.4;
  transition: opacity 0.3s;
}

.logoGrid span:hover { opacity: 0.85; }

/* ═══════════════════════════════════════════════════════════════
   OVERVIEW
   ═══════════════════════════════════════════════════════════════ */
.overviewSection {
  padding: 90px 0;
  background: var(--white);
}

.overviewGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}

.overviewText h2 {
  font-family: var(--font-display);
  font-size: clamp(1.9rem, 3.3vw, 2.6rem);
  font-weight: 400;
  letter-spacing: -0.03em;
  color: var(--charcoal700);
  margin-bottom: 20px;
  line-height: 1.1;
}

.overviewText p {
  font-family: var(--font-display);
  font-size: 1rem;
  line-height: 1.6;
  color: var(--charcoal500);
  margin-bottom: 16px;
}

.overviewStats {
  display: flex;
  gap: 30px;
  margin-top: 24px;
}

.overviewStat { text-align: center; }

.overviewStat span {
  display: block;
  font-family: var(--font-display);
  font-size: 1.8rem;
  font-weight: 500;
  color: var(--orangesaturated01);
  letter-spacing: -0.02em;
  line-height: 1.2;
}

.overviewStat label {
  font-family: var(--font-display);
  font-size: 0.8rem;
  color: var(--charcoal500);
}

.overviewImage img {
  width: 100%;
  border-radius: 20px;
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
}

@media (max-width: 992px) {
  .overviewGrid { grid-template-columns: 1fr; gap: 40px; }
  .overviewStats { justify-content: center; }
}

@media (max-width: 600px) {
  .overviewSection { padding: 60px 0; }
}

/* ═══════════════════════════════════════════════════════════════
   PAGE BREAK — solid green banner, pastel icon chip
   ═══════════════════════════════════════════════════════════════ */
.pageBreak {
  padding: 70px 0;
  background: var(--greendark02);
  position: relative;
  overflow: hidden;
}

.pageBreak::before {
  content: '';
  position: absolute;
  inset: -50%;
  background: radial-gradient(circle at 30% 50%, rgba(139, 236, 92, 0.10) 0%, transparent 60%);
  animation: pulseBg 8s ease-in-out infinite;
}

@keyframes pulseBg {
  0%, 100% { transform: scale(1); opacity: 0.5; }
  50% { transform: scale(1.1); opacity: 1; }
}

.pageBreakContent {
  position: relative;
  z-index: 1;
  text-align: center;
  max-width: 760px;
  margin: 0 auto;
  padding: 20px;
}

.pageBreakIcon {
  width: 68px;
  height: 68px;
  border-radius: 50%;
  background: var(--greensaturated02);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20px;
  color: var(--greendark01);
}

.pageBreakContent h3 {
  font-family: var(--font-display);
  font-size: clamp(1.4rem, 2.5vw, 1.8rem);
  font-weight: 400;
  letter-spacing: -0.02em;
  color: var(--white);
  margin-bottom: 16px;
}

.pageBreakContent p {
  font-family: var(--font-display);
  font-size: 1.05rem;
  line-height: 1.6;
  color: var(--greengray02);
  margin-bottom: 28px;
}

.pageBreakStats {
  display: flex;
  gap: 20px;
  justify-content: center;
  flex-wrap: wrap;
}

.pageBreakStats > div {
  flex: 1;
  min-width: 180px;
  max-width: 280px;
  padding: 20px;
  background: rgba(249, 249, 248, 0.06);
  border-radius: 16px;
  border: 0.99px solid rgba(249, 249, 248, 0.1);
}

.pageBreakStats span {
  display: block;
  font-family: var(--font-display);
  font-size: 1.9rem;
  font-weight: 500;
  color: var(--greensaturated02);
  letter-spacing: -0.02em;
  line-height: 1.2;
  margin-bottom: 4px;
}

.pageBreakStats label {
  font-family: var(--font-display);
  font-size: 0.85rem;
  color: rgba(249, 249, 248, 0.7);
  line-height: 1.4;
}

@media (max-width: 600px) {
  .pageBreak { padding: 45px 0; }
  .pageBreakStats { gap: 16px; flex-direction: column; align-items: center; }
  .pageBreakStats > div { width: 100%; max-width: 320px; }
}

/* ═══════════════════════════════════════════════════════════════
   SECTION HEADER (shared)
   ═══════════════════════════════════════════════════════════════ */
.sectionHeader {
  max-width: 720px;
  margin: 0 auto 48px;
  text-align: center;
}

.sectionHeader h2 {
  font-family: var(--font-display);
  font-size: clamp(1.9rem, 3.3vw, 2.6rem);
  font-weight: 400;
  letter-spacing: -0.03em;
  color: var(--charcoal700);
  margin-bottom: 16px;
}

.sectionHeader p {
  font-family: var(--font-display);
  font-size: 1.05rem;
  line-height: 1.6;
  color: var(--charcoal500);
}

/* ═══════════════════════════════════════════════════════════════
   HOW IT WORKS
   ═══════════════════════════════════════════════════════════════ */
.howSection {
  padding: 90px 0;
  background: var(--greenpastel02);
}

.howGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px 40px;
  max-width: 900px;
  margin: 0 auto;
}

.howItem {
  display: flex;
  gap: 16px;
  align-items: flex-start;
  padding: 20px;
  background: var(--purewhite);
  border-radius: 16px;
}

.howIcon {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--greenpastel01);
  color: var(--greendark02);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2px;
}

.howItem h3 {
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 500;
  color: var(--charcoal700);
  margin: 0 0 4px;
}

.howItem p {
  font-family: var(--font-display);
  font-size: 0.9rem;
  line-height: 1.5;
  color: var(--charcoal500);
  margin: 0;
}

@media (max-width: 900px) {
  .howGrid { grid-template-columns: 1fr; }
}

@media (max-width: 600px) {
  .howSection { padding: 60px 0; }
}

/* ═══════════════════════════════════════════════════════════════
   FEATURES
   ═══════════════════════════════════════════════════════════════ */
.featuresSection {
  padding: 90px 0;
  background: var(--white);
}

.featuresGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  max-width: 960px;
  margin: 0 auto;
}

.featureItem {
  display: flex;
  gap: 16px;
  align-items: flex-start;
  padding: 24px;
  background: var(--greenpastel02);
  border-radius: 16px;
  transition: transform 0.2s ease;
}

.featureItem:hover { transform: translateY(-4px); }

.featureIcon {
  width: 44px;
  height: 44px;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--purewhite);
  color: var(--orangesaturated01);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2px;
}

.featureItem h3 {
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 500;
  color: var(--charcoal700);
  margin: 0 0 4px;
}

.featureItem p {
  font-family: var(--font-display);
  font-size: 0.9rem;
  line-height: 1.5;
  color: var(--charcoal500);
  margin: 0;
}

@media (max-width: 900px) {
  .featuresGrid { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 600px) {
  .featuresGrid { grid-template-columns: 1fr; gap: 16px; }
  .featuresSection { padding: 60px 0; }
}

/* ═══════════════════════════════════════════════════════════════
   GAUGES
   ═══════════════════════════════════════════════════════════════ */
.gaugesSection {
  padding: 90px 0;
  background: var(--greendark01);
}

.gaugesSection .sectionHeader h2,
.gaugesSection .sectionHeader p { color: var(--white); }
.gaugesSection .sectionHeader p { color: var(--greengray02); }

.gaugesGrid {
  display: flex;
  justify-content: center;
  gap: 60px;
  flex-wrap: wrap;
  max-width: 800px;
  margin: 0 auto;
}

.gaugeItem {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
}

.gaugeWrap { position: relative; width: 120px; height: 120px; }
.gaugeSvg { width: 100%; height: 100%; }

.gaugeTrack {
  fill: none;
  stroke: rgba(249, 249, 248, 0.12);
  stroke-width: 10;
}

.gaugeFill { fill: none; stroke-width: 10; stroke-linecap: round; }

.gaugeValue {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 1.35rem;
  font-weight: 500;
  color: var(--white);
}

.gaugeLabel {
  font-family: var(--font-display);
  font-size: 0.85rem;
  color: var(--greengray02);
  text-align: center;
  max-width: 160px;
}

@media (max-width: 600px) {
  .gaugesGrid { gap: 36px; }
}

/* ═══════════════════════════════════════════════════════════════
   BENEFITS
   ═══════════════════════════════════════════════════════════════ */
.benefitsSection {
  padding: 90px 0;
  background: var(--white);
}

.benefitsGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px 40px;
  max-width: 900px;
  margin: 0 auto;
}

.benefitItem {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  padding: 14px 16px;
  border-radius: 12px;
  transition: background 0.2s ease;
}

.benefitItem:hover { background: var(--greenpastel02); }

.benefitIcon {
  width: 32px;
  height: 32px;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--orangepastel02);
  color: var(--orangesaturated01);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2px;
}

.benefitItem h3 {
  font-family: var(--font-display);
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--charcoal700);
  margin: 0 0 2px;
}

.benefitItem p {
  font-family: var(--font-display);
  font-size: 0.85rem;
  line-height: 1.5;
  color: var(--charcoal500);
  margin: 0;
}

@media (max-width: 900px) {
  .benefitsGrid { grid-template-columns: 1fr; }
}

@media (max-width: 600px) {
  .benefitsSection { padding: 60px 0; }
}

/* ═══════════════════════════════════════════════════════════════
   TESTIMONIAL
   ═══════════════════════════════════════════════════════════════ */
.testimonialSection {
  padding: 90px 0;
  background: var(--greendark02);
}

.testimonialContent {
  max-width: 760px;
  margin: 0 auto;
  text-align: center;
  color: var(--white);
  padding: 0 20px;
}

.testimonialQuote {
  font-family: var(--font-display);
  font-size: 4rem;
  color: var(--greensaturated02);
  opacity: 0.4;
  line-height: 1;
  margin-bottom: -20px;
}

.testimonialContent blockquote {
  font-family: var(--font-display);
  font-size: clamp(1.15rem, 2vw, 1.4rem);
  line-height: 1.5;
  font-weight: 400;
  letter-spacing: -0.01em;
  color: var(--white);
  margin: 0 0 20px;
}

.testimonialAuthor {
  display: flex;
  flex-direction: column;
  gap: 2px;
  font-family: var(--font-display);
}

.testimonialAuthor strong {
  font-size: 1rem;
  font-weight: 500;
  color: var(--white);
}

.testimonialAuthor span {
  font-size: 0.85rem;
  color: var(--greengray02);
}

/* ═══════════════════════════════════════════════════════════════
   CTA — final radial-glow card, matches Campfire's closing section
   ═══════════════════════════════════════════════════════════════ */
.ctaSection {
  padding: 90px 0;
  background: var(--greendark01);
}

.ctaBox {
  max-width: 700px;
  margin: 0 auto;
  color: var(--white);
  text-align: center;
  padding: 60px 40px;
  background: rgba(249, 249, 248, 0.05);
  border-radius: 30px;
  border: 0.99px solid rgba(249, 249, 248, 0.08);
  position: relative;
  overflow: hidden;
}

.ctaBox::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(151.14% 151.14% at 50% 50%, rgba(255, 134, 47, 0.15) 0%, rgba(255, 134, 47, 0) 100%);
  pointer-events: none;
}

.ctaBox > * { position: relative; z-index: 1; }

.ctaBox h2 {
  font-family: var(--font-display);
  font-size: clamp(1.9rem, 3.3vw, 2.6rem);
  font-weight: 400;
  letter-spacing: -0.03em;
  margin-bottom: 16px;
}

.ctaBox p {
  font-family: var(--font-display);
  font-size: 1rem;
  line-height: 1.6;
  color: var(--greengray02);
  margin-bottom: 28px;
}

.ctaButtons {
  display: flex;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
}

.ctaConsent {
  font-family: var(--font-display);
  font-size: 0.72rem;
  color: var(--greengray02);
  margin-top: 20px;
}

@media (max-width: 600px) {
  .ctaBox { padding: 40px 20px; }
}