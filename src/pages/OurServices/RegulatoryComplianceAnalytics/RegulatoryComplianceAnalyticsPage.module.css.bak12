/* src/pages/Services/RegulatoryComplianceAnalytics/RegulatoryComplianceAnalyticsPage.module.css */

* { margin: 0; padding: 0; box-sizing: border-box; }

.container { max-width: 1200px; margin: 0 auto; padding: 0 40px; }
.highlight { color: #fdb840; }

.sectionBadge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #999;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  margin-bottom: 12px;
}

.sectionTitle {
  font-size: 36px;
  font-weight: 700;
  color: #1a1a2e;
  margin: 0 0 12px;
  line-height: 1.2;
}

.sectionSubtitle {
  font-size: 16px;
  color: #888;
  max-width: 700px;
  margin: 0 auto;
  line-height: 1.7;
}

/* ─── HERO ────────────────────────────────────────────────────── */
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  background: #fafafa;
  overflow: hidden;
  padding: 40px 0;
}

.heroBg { position: absolute; inset: 0; z-index: 0; }

.heroPattern {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(253, 184, 64, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(253, 184, 64, 0.03) 1px, transparent 1px);
  background-size: 40px 40px;
}

.heroGradient {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 70% 30%, rgba(253, 184, 64, 0.08) 0%, transparent 60%);
}

.heroParticles { position: absolute; inset: 0; overflow: hidden; }
.particle { position: absolute; background: #fdb840; border-radius: 50%; }

.heroLayout {
  position: relative;
  z-index: 1;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 40px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}

.heroLeft { padding-top: 20px; }

.heroBadge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #fdb840;
  padding: 0 0 6px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  margin-bottom: 20px;
  border-bottom: 1px solid rgba(253, 184, 64, 0.3);
}

.heroTitle {
  font-size: 48px;
  font-weight: 700;
  line-height: 1.15;
  color: #1a1a2e;
  margin: 0 0 20px;
  display: flex;
  flex-direction: column;
}

.heroTitleLine { display: block; }

.heroDescription {
  font-size: 18px;
  color: #555;
  line-height: 1.8;
  max-width: 540px;
  margin: 0 0 32px;
}

.heroActions { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 32px; }

.primaryBtn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 32px;
  background: #fdb840;
  color: #1a1a2e;
  font-weight: 700;
  font-size: 14px;
  text-decoration: none;
  transition: all 0.3s ease;
  border: none;
  cursor: pointer;
}
.primaryBtn:hover { transform: translateY(-3px); box-shadow: 0 8px 30px rgba(253, 184, 64, 0.25); }
.primaryBtn .btnArrow { transition: transform 0.3s ease; }
.primaryBtn:hover .btnArrow { transform: translateX(4px); }

.secondaryBtn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 32px 12px;
  background: transparent;
  color: #1a1a2e;
  font-weight: 600;
  font-size: 14px;
  text-decoration: none;
  border-bottom: 2px solid #ddd;
  transition: all 0.3s ease;
  cursor: pointer;
}
.secondaryBtn:hover { border-color: #fdb840; color: #fdb840; }

.heroTrust { display: flex; gap: 20px; flex-wrap: wrap; }
.heroTrust span { display: flex; align-items: center; gap: 6px; font-size: 13px; color: #666; }

.heroRight { display: flex; flex-direction: column; gap: 28px; align-items: center; }

/* ─── SCAN ────────────────────────────────────────────────────── */
.scanContainer { display: flex; flex-direction: column; align-items: center; gap: 16px; }
.scanCircle { position: relative; width: 200px; height: 200px; }
.scanPulse { position: absolute; inset: -10px; border-radius: 50%; border: 2px solid rgba(253, 184, 64, 0.2); }
.scanRing {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  border: 1px solid rgba(253, 184, 64, 0.15); border-radius: 50%; width: 100%; height: 100%;
}
.scanCenter {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  width: 56px; height: 56px; border-radius: 50%;
  background: rgba(253, 184, 64, 0.1); border: 2px solid rgba(253, 184, 64, 0.25);
  display: flex; align-items: center; justify-content: center;
}
.scanShield { color: #fdb840; }
.scanBeam {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  width: 3px; height: 85%;
  background: linear-gradient(to bottom, transparent, rgba(253, 184, 64, 0.5));
  transform-origin: center bottom; border-radius: 2px;
}
.scanStatus { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #888; }
.scanDot { width: 6px; height: 6px; background: #27ae60; border-radius: 50%; }

/* ─── STATUS LINE (replaces boxed metrics strip) ─────────────── */
.statusLine {
  display: flex;
  align-items: center;
  gap: 18px;
  font-size: 13px;
  color: #666;
  padding-bottom: 10px;
  border-bottom: 1px solid #e8e8e8;
  width: 100%;
}
.statusItem { display: flex; align-items: center; gap: 6px; font-weight: 600; color: #1a1a2e; white-space: nowrap; }
.statusDivider { width: 1px; height: 14px; background: #ddd; }
.stripDot { width: 6px; height: 6px; background: #27ae60; border-radius: 50%; display: inline-block; }

/* ─── WAVES ────────────────────────────────────────────────────── */
.waveContainer { width: 100%; }
.waveSvg { width: 100%; height: 60px; }
.waveLabels {
  display: flex; justify-content: space-between; margin-top: 4px;
  font-size: 10px; font-weight: 600; color: #ccc; text-transform: uppercase; letter-spacing: 0.5px;
}

/* ─── WHAT IS ────────────────────────────────────────────────── */
.whatIs { padding: 100px 0; background: #ffffff; }
.whatIsLayout { display: grid; grid-template-columns: 1.6fr 1fr; gap: 60px; align-items: start; }
.whatIsContent { max-width: 700px; }
.paragraphs { font-size: 16px; color: #555; line-height: 1.8; }
.paragraphs p { margin-bottom: 16px; }

.whatIsSidebar { display: flex; flex-direction: column; gap: 26px; padding-top: 8px; }
.statLine { display: flex; flex-direction: column; }
.statLineValue { font-size: 30px; font-weight: 800; color: #1a1a2e; line-height: 1; }
.statLineLabel { font-size: 13px; color: #888; margin-top: 6px; }
.statLineBar {
  display: block; height: 2px; width: 100%; margin-top: 12px;
  background: #fdb840; transform-origin: left; opacity: 0.5;
}

/* ─── FRAMEWORKS — flowing index, no cards ───────────────────── */
.frameworks { padding: 100px 0; background: #ffffff; }
.frameworksHeader { text-align: center; margin-bottom: 50px; }

.frameworksList { display: flex; flex-direction: column; }
.frameworkRow { position: relative; border-bottom: 1px solid #ececec; }
.frameworkRowLine { height: 2px; width: 100%; transform-origin: left; }
.frameworkRowHead {
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 20px 4px;
  cursor: pointer;
}
.frameworkRowIndex { font-size: 13px; color: #ccc; font-weight: 700; width: 26px; }
.frameworkRowName { font-size: 22px; font-weight: 800; flex: 0 0 140px; }
.frameworkRowPenalty { font-size: 13px; color: #e74c3c; flex: 1; }
.frameworkRowReq { font-size: 13px; color: #999; font-weight: 600; }
.frameworkRowToggle { color: #bbb; display: flex; }

.frameworkRowBody { padding: 0 4px 28px 46px; }
.frameworkRowDesc { font-size: 15px; color: #555; line-height: 1.7; margin: 0 0 16px; max-width: 720px; }
.frameworkKeyFlow { display: flex; flex-wrap: wrap; gap: 10px 18px; }
.frameworkKeyChip {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 13px; color: #555;
}
.frameworkKeyChip svg { color: #fdb840; }

/* ─── VIOLATIONS — vertical timeline, no cards ───────────────── */
.violations { padding: 100px 0; background: #f8f9fc; }
.violationsContainer { max-width: 900px; margin: 0 auto; }
.violationsHeader { margin-bottom: 50px; }
.violationsBadge {
  display: inline-flex; align-items: center; gap: 8px;
  color: #e74c3c; font-size: 12px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase;
  margin-bottom: 12px;
}
.violationsSubtitle { font-size: 16px; color: #888; line-height: 1.6; margin: 0; max-width: 700px; }

.timeline { position: relative; padding-left: 30px; }
.timelineTrack {
  position: absolute; left: 4px; top: 6px; bottom: 6px; width: 2px; background: #e2e2ea;
}
.timelineFill {
  position: absolute; left: 0; top: 0; width: 100%; background: #fdb840;
}
.timelineRow { position: relative; padding-bottom: 40px; }
.timelineRow:last-child { padding-bottom: 0; }
.timelineDot {
  position: absolute; left: -30px; top: 6px;
  width: 10px; height: 10px; border-radius: 50%; background: #fdb840;
  box-shadow: 0 0 0 4px rgba(253, 184, 64, 0.15);
}
.timelineContent { cursor: pointer; }
.violationTop { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-bottom: 6px; }
.violationCompany { font-size: 18px; font-weight: 700; color: #1a1a2e; }
.violationFine { font-size: 14px; font-weight: 700; color: #e74c3c; }
.violationRegulation { font-size: 11px; font-weight: 700; color: #fdb840; text-transform: uppercase; letter-spacing: 0.4px; }
.violationYear { font-size: 12px; color: #999; }
.violationDescription { font-size: 14px; color: #555; line-height: 1.6; margin: 0; max-width: 700px; }
.violationExpand { padding-top: 12px; }
.violationImpact { font-size: 14px; color: #555; line-height: 1.6; margin: 0 0 8px; max-width: 700px; }
.violationLessons { font-size: 14px; color: #555; line-height: 1.6; margin: 0; max-width: 700px; }
.violationToggle { display: inline-block; font-size: 12px; color: #fdb840; font-weight: 600; margin-top: 10px; }

/* ─── CHALLENGES — marquee + alternating flow ────────────────── */
.challenges { padding: 100px 0; background: #ffffff; overflow: hidden; }
.challengesContainer { max-width: 1000px; margin: 0 auto; padding: 0 40px; }
.challengesHeader { text-align: center; margin-bottom: 40px; }
.challengesBadge {
  display: inline-flex; align-items: center; gap: 8px;
  color: #fdb840; font-size: 12px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase;
  margin-bottom: 12px;
}
.challengesTitle { font-size: 32px; font-weight: 700; color: #1a1a2e; margin: 0; }

.marqueeMask { width: 100%; overflow: hidden; margin: 40px 0 60px; border-top: 1px solid #ececec; border-bottom: 1px solid #ececec; padding: 16px 0; }
.marqueeTrack { display: flex; width: max-content; }
.marqueeItem {
  display: inline-flex; align-items: center; gap: 24px;
  font-size: 20px; font-weight: 700; color: #1a1a2e; white-space: nowrap; padding-right: 24px;
}
.marqueeDot { color: #fdb840; }

.challengesFlow { display: flex; flex-direction: column; gap: 50px; }
.challengeFlowRow { display: flex; align-items: flex-start; gap: 28px; }
.challengeFlowRowReverse { flex-direction: row-reverse; text-align: right; }
.challengeFlowIcon { color: #fdb840; flex-shrink: 0; margin-top: 4px; }
.challengeFlowText { max-width: 640px; }
.challengeTitle { font-size: 18px; font-weight: 700; color: #1a1a2e; margin: 0 0 8px; }
.challengeDescription { font-size: 15px; color: #555; line-height: 1.7; margin: 0; }

/* ─── SOLUTIONS — zig-zag flow with drawn connecting line ────── */
.solutions { padding: 100px 0; background: #f8f9fc; }
.solutionsContainer { max-width: 900px; margin: 0 auto; }
.solutionsHeader { text-align: center; margin-bottom: 50px; }
.solutionsBadge {
  display: inline-flex; align-items: center; gap: 8px;
  color: #fdb840; font-size: 12px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase;
  margin-bottom: 12px;
}
.solutionsTitle { font-size: 32px; font-weight: 700; color: #1a1a2e; margin: 0 0 8px; }
.solutionsSubtitle { font-size: 16px; color: #888; max-width: 700px; margin: 0 auto; }

.solutionsFlowWrap { position: relative; display: flex; flex-direction: column; gap: 44px; margin-top: 50px; }
.solutionsPath { position: absolute; left: 20px; top: 0; width: 2px; height: 100%; overflow: visible; }
.solutionFlowRow { display: flex; gap: 24px; align-items: flex-start; padding-left: 50px; }
.solutionFlowRowReverse { padding-left: 50px; }
.solutionFlowIndex { font-size: 14px; font-weight: 800; color: #fdb840; width: 30px; flex-shrink: 0; }
.solutionTitle { font-size: 17px; font-weight: 700; color: #1a1a2e; margin: 0 0 6px; }
.solutionDescription { font-size: 14px; color: #555; line-height: 1.7; margin: 0; max-width: 620px; }

/* ─── STATS ────────────────────────────────────────────────────── */
.stats { padding: 100px 0; background: #1a1a2e; }
.statsHeader { text-align: center; margin-bottom: 50px; }
.statsTitle { font-size: 32px; font-weight: 700; color: #ffffff; margin: 0 0 8px; }
.statsSubtitle { font-size: 16px; color: rgba(255, 255, 255, 0.5); max-width: 600px; margin: 0 auto; }

.statsFlowRow {
  display: flex;
  justify-content: space-between;
  max-width: 1000px;
  margin: 0 auto;
}
.statFlowItem {
  text-align: center;
  flex: 1;
  padding: 0 20px;
  border-left: 1px solid rgba(255, 255, 255, 0.1);
}
.statFlowItem:first-child { border-left: none; }
.statValue { display: block; font-size: 44px; font-weight: 800; color: #fdb840; line-height: 1; }
.statLabel { display: block; font-size: 15px; font-weight: 600; color: #ffffff; margin: 8px 0 4px; }
.statDesc { display: block; font-size: 13px; color: rgba(255, 255, 255, 0.4); }

/* ─── CTA ────────────────────────────────────────────────────── */
.cta { padding: 100px 0; background: #ffffff; }
.ctaContent { max-width: 720px; margin: 0 auto; text-align: center; }
.ctaBadge {
  display: inline-flex; align-items: center; gap: 8px;
  color: #fdb840; font-size: 12px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase;
  margin-bottom: 16px;
}
.ctaTitle { font-size: 36px; font-weight: 700; color: #1a1a2e; margin: 0 0 12px; line-height: 1.2; }
.ctaHighlight { color: #fdb840; }
.ctaDesc { font-size: 16px; color: #555; line-height: 1.8; margin: 0 auto 32px; }
.ctaBtn {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 14px 32px; background: #fdb840; color: #1a1a2e;
  font-weight: 700; font-size: 14px; text-decoration: none; transition: all 0.3s ease;
}
.ctaBtn:hover { transform: translateY(-3px); box-shadow: 0 8px 30px rgba(253, 184, 64, 0.25); }
.ctaBtn .btnArrow { transition: transform 0.3s ease; }
.ctaBtn:hover .btnArrow { transform: translateX(4px); }
.ctaTrust { display: flex; justify-content: center; gap: 24px; flex-wrap: wrap; margin-top: 28px; }
.ctaTrust span { display: flex; align-items: center; gap: 6px; font-size: 13px; color: #888; }

/* ─── RESPONSIVE ───────────────────────────────────────────────── */
@media (max-width: 1024px) {
  .heroLayout { grid-template-columns: 1fr; gap: 40px; }
  .heroTitle { font-size: 38px; }
  .whatIsLayout { grid-template-columns: 1fr; gap: 40px; }
  .frameworkRowHead { flex-wrap: wrap; }
  .frameworkRowName { flex: 0 0 auto; }
  .statsFlowRow { flex-wrap: wrap; gap: 30px; }
  .statFlowItem { flex: 1 1 45%; border-left: none; }
}

@media (max-width: 768px) {
  .hero { padding: 20px 0; }
  .container { padding: 0 20px; }
  .challengesContainer { padding: 0 20px; }
  .heroTitle { font-size: 30px; }
  .heroDescription { font-size: 16px; }
  .sectionTitle { font-size: 28px; }
  .statusLine { flex-wrap: wrap; gap: 10px; }
  .statusDivider { display: none; }
  .challengeFlowRow, .challengeFlowRowReverse { flex-direction: row; text-align: left; }
  .solutionFlowRow, .solutionFlowRowReverse { padding-left: 40px; }
  .solutionsPath { left: 14px; }
}

@media (max-width: 480px) {
  .heroTitle { font-size: 24px; }
  .heroActions { flex-direction: column; }
  .primaryBtn, .secondaryBtn { justify-content: center; }
  .ctaBtn { justify-content: center; }
  .statFlowItem { flex: 1 1 100%; }
  .violationTop { flex-wrap: wrap; }
}