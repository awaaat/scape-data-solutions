/* src/pages/Services/ExcelDecisionModeling/ExcelDecisionModelingPage.module.css */

/* ─── Container ────────────────────────────────────────────────── */
.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
}

/* ─── Hero ──────────────────────────────────────────────────────── */
.heroSection {
  position: relative;
  min-height: 70vh;
  background: #0d0d1a;
  display: flex;
  align-items: center;
  padding: 80px 0 60px;
  overflow: hidden;
}

.heroOverlay {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 30% 60%, rgba(253, 184, 64, 0.07) 0%, transparent 70%);
  z-index: 0;
}

.heroContent {
  position: relative;
  z-index: 1;
  max-width: 820px;
  margin: 0 auto;
  text-align: center;
}

.heroBadge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(253, 184, 64, 0.12);
  color: #fdb840;
  padding: 6px 18px;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  border-radius: 30px;
  margin-bottom: 16px;
}

.heroTitle {
  font-size: 48px;
  font-weight: 800;
  line-height: 1.12;
  color: #ffffff;
  margin: 0 0 16px;
}

.highlight {
  color: #fdb840;
}

.heroSub {
  font-size: 18px;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.7;
  max-width: 640px;
  margin: 0 auto 28px;
}

.heroCta {
  display: flex;
  gap: 14px;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 36px;
}

.heroBtn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 34px;
  background: #fdb840;
  color: #0d0d1a;
  font-weight: 700;
  font-size: 15px;
  border: none;
  border-radius: 4px;
  text-decoration: none;
  cursor: pointer;
  transition: background 0.25s, transform 0.15s;
}
.heroBtn:hover {
  background: #e5a632;
}

.heroBtnSecondary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 30px;
  background: transparent;
  color: #ffffff;
  font-weight: 600;
  font-size: 15px;
  border: 2px solid rgba(255, 255, 255, 0.25);
  border-radius: 4px;
  text-decoration: none;
  transition: border-color 0.25s, color 0.25s;
}
.heroBtnSecondary:hover {
  border-color: #fdb840;
  color: #fdb840;
}

.heroStats {
  display: flex;
  justify-content: center;
  gap: 48px;
  margin-top: 12px;
}

.statItem {
  text-align: center;
}

.statValue {
  display: block;
  font-size: 30px;
  font-weight: 800;
  color: #fdb840;
}

.statLabel {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.5);
  text-transform: uppercase;
  letter-spacing: 0.4px;
}

/* ─── Overview ──────────────────────────────────────────────────── */
.overviewSection {
  padding: 70px 0;
  background: #ffffff;
}

.overviewGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 50px;
  align-items: center;
}

.overviewText h2 {
  font-size: 34px;
  font-weight: 700;
  color: #0d0d1a;
  margin: 0 0 16px;
}
.overviewText h2 .highlight {
  color: #fdb840;
}

.overviewText p {
  font-size: 16px;
  line-height: 1.8;
  color: #555;
  margin: 0 0 14px;
}
.overviewText p:last-child {
  margin-bottom: 0;
}

.overviewVisual {
  display: flex;
  justify-content: center;
  align-items: center;
}

.visualPlaceholder {
  width: 100%;
  max-width: 400px;
  aspect-ratio: 16 / 10;
  background: #f5f6fa;
  border: 2px dashed #d0d7de;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  color: #a0a5b0;
  font-weight: 500;
  font-size: 15px;
  border-radius: 8px;
}
.visualPlaceholder svg {
  color: #fdb840;
}

/* ─── Section Title ────────────────────────────────────────────── */
.sectionTitle {
  font-size: 32px;
  font-weight: 700;
  color: #0d0d1a;
  text-align: center;
  margin: 0 0 8px;
}

/* ─── Features ──────────────────────────────────────────────────── */
.featuresSection {
  padding: 60px 0 70px;
  background: #f8f9fc;
}

.featuresGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.featureCard {
  background: #ffffff;
  padding: 28px 24px;
  border: 1px solid #eaeef2;
  border-radius: 6px;
  transition: box-shadow 0.2s, transform 0.2s;
}

.featureIcon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  background: rgba(253, 184, 64, 0.1);
  border-radius: 8px;
  color: #fdb840;
  margin-bottom: 14px;
}

.featureCard h3 {
  font-size: 17px;
  font-weight: 700;
  color: #0d0d1a;
  margin: 0 0 8px;
}

.featureCard p {
  font-size: 14px;
  color: #666;
  line-height: 1.6;
  margin: 0;
}

/* ─── Applications ──────────────────────────────────────────────── */
.applicationsSection {
  padding: 60px 0;
  background: #ffffff;
}

.applicationsGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.applicationCard {
  padding: 26px 22px;
  background: #f8f9fc;
  border: 1px solid #eaeef2;
  border-radius: 6px;
  text-align: center;
  transition: transform 0.2s, box-shadow 0.2s;
}
.applicationCard:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
}

.applicationIcon {
  color: #fdb840;
  margin-bottom: 10px;
}

.applicationCard h3 {
  font-size: 17px;
  font-weight: 700;
  color: #0d0d1a;
  margin: 0 0 6px;
}

.applicationCard p {
  font-size: 14px;
  color: #666;
  line-height: 1.6;
  margin: 0;
}

/* ─── Process ──────────────────────────────────────────────────── */
.processSection {
  padding: 60px 0 70px;
  background: #f8f9fc;
}

.processGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.processCard {
  background: #ffffff;
  padding: 26px 22px;
  border: 1px solid #eaeef2;
  border-radius: 6px;
  border-left: 4px solid #fdb840;
}

.processStep {
  font-size: 11px;
  font-weight: 700;
  color: #fdb840;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 6px;
}

.processCard h3 {
  font-size: 17px;
  font-weight: 700;
  color: #0d0d1a;
  margin: 0 0 8px;
}

.processCard p {
  font-size: 14px;
  color: #666;
  line-height: 1.6;
  margin: 0;
}

/* ─── Benefits ──────────────────────────────────────────────────── */
.benefitsSection {
  padding: 60px 0;
  background: #ffffff;
}

.benefitsGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px 32px;
  max-width: 800px;
  margin: 0 auto;
}

.benefitCard {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  padding: 12px 0;
  border-bottom: 1px solid #f0f2f5;
}
.benefitCard:last-child {
  border-bottom: none;
}

.benefitIcon {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  background: rgba(253, 184, 64, 0.08);
  border-radius: 50%;
  color: #fdb840;
}

.benefitCard h3 {
  font-size: 15px;
  font-weight: 700;
  color: #0d0d1a;
  margin: 0 0 2px;
}

.benefitCard p {
  font-size: 14px;
  color: #666;
  line-height: 1.5;
  margin: 0;
}

/* ─── CTA ───────────────────────────────────────────────────────── */
.ctaSection {
  padding: 70px 0;
  background: #0d0d1a;
}

.ctaContent {
  max-width: 640px;
  margin: 0 auto;
  text-align: center;
}

.ctaContent h2 {
  font-size: 34px;
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 14px;
}

.ctaContent p {
  font-size: 17px;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.7;
  margin: 0 0 28px;
}

.ctaBtn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 16px 40px;
  background: #fdb840;
  color: #0d0d1a;
  font-weight: 700;
  font-size: 16px;
  border: none;
  border-radius: 4px;
  text-decoration: none;
  transition: background 0.25s, transform 0.15s;
}
.ctaBtn:hover {
  background: #e5a632;
}

/* ─── Responsive ────────────────────────────────────────────────── */
@media (max-width: 1024px) {
  .heroTitle {
    font-size: 38px;
  }
  .overviewGrid {
    grid-template-columns: 1fr;
    gap: 30px;
  }
  .visualPlaceholder {
    max-width: 100%;
  }
  .featuresGrid,
  .applicationsGrid,
  .processGrid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 768px) {
  .heroTitle {
    font-size: 28px;
  }
  .heroSub {
    font-size: 15px;
  }
  .heroStats {
    gap: 24px;
    flex-wrap: wrap;
  }
  .statValue {
    font-size: 24px;
  }
  .overviewText h2 {
    font-size: 26px;
  }
  .featuresGrid,
  .applicationsGrid,
  .processGrid {
    grid-template-columns: 1fr;
  }
  .benefitsGrid {
    grid-template-columns: 1fr;
    gap: 8px;
  }
  .ctaContent h2 {
    font-size: 26px;
  }
  .heroCta {
    flex-direction: column;
    align-items: center;
  }
  .heroBtn,
  .heroBtnSecondary {
    width: 100%;
    justify-content: center;
  }
  .sectionTitle {
    font-size: 26px;
  }
}

@media (max-width: 480px) {
  .heroTitle {
    font-size: 22px;
  }
  .container {
    padding: 0 16px;
  }
  .heroSection {
    min-height: auto;
    padding: 60px 0 40px;
  }
  .featureCard,
  .applicationCard,
  .processCard {
    padding: 20px 16px;
  }
  .visualPlaceholder {
    aspect-ratio: 16 / 11;
  }
}