        >
          <h2>Case Studies</h2>
          <motion.div initial="hidden" whileInView="visible" viewport={VIEWPORT} variants={stagger}>
            <motion.p variants={fadeUp}>
              <strong><a href="https://gigaom.com/2012/11/20/how-aetna-is-using-big-data-to-improve-patient-health/" target="_blank" rel="noreferrer">AETNA</a>:</strong>{" "}
              Analyzes patient metabolic-syndrome test results and risk factors to focus treatment on
              the one or two changes most likely to improve health outcomes.
            </motion.p>
            <motion.p variants={fadeUp}>
              <strong><a href="https://blog.pivotal.io/big-data-pivotal/features/20-examples-of-roi-and-results-with-big-data" target="_blank" rel="noreferrer">American Express</a>:</strong>{" "}
              Built predictive models across 115 variables from historical transactions to forecast
              churn, now identifying a meaningful share of accounts likely to close within months.
            </motion.p>
            <motion.p variants={fadeUp}>
              <strong><a href="http://www.cioinsight.com/it-strategy/big-data/slideshows/11-great-things-companies-are-doing-with-big-data.html" target="_blank" rel="noreferrer">Atlanta Falcons</a>:</strong>{" "}
              Uses GPS tracking during practices to help coaches design more efficient plays.
            </motion.p>
            <motion.p variants={fadeUp}>
              <strong><a href="http://www.cioinsight.com/it-strategy/big-data/slideshows/11-great-things-companies-are-doing-with-big-data.html" target="_blank" rel="noreferrer">Bank of America</a>:</strong>{" "}
              Its "BankAmeriDeals" program offers cash-back deals based on analysis of prior card
              purchases.
            </motion.p>
            <motion.p variants={fadeUp}>
              <strong><a href="http://smartdatacollective.com/rick-delgado/203966/5-companies-doing-big-data-right" target="_blank" rel="noreferrer">British Airways</a>:</strong>{" "}
              Combines loyalty data with online behavior to make targeted offers and recover service
              lapses more effectively.
            </motion.p>
            <motion.p variants={fadeUp}>
              <strong><a href="http://www.cioinsight.com/it-strategy/big-data/slideshows/11-great-things-companies-are-doing-with-big-data.html" target="_blank" rel="noreferrer">Caesars Entertainment</a>:</strong>{" "}
              Combines gambling outcomes with rewards data to offer perks to patrons on losing streaks.
            </motion.p>
            <motion.p variants={fadeUp}>
              <strong><a href="https://www.fastcompany.com/3041638/most-innovative-companies-2015/the-worlds-top-10-most-innovative-companies-in-big-data" target="_blank" rel="noreferrer">Catapult</a>:</strong>{" "}
              Surfaces early signs of athlete injury risk and workout strain, now used across major
