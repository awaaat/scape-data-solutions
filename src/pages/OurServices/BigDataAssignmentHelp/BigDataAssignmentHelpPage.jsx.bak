// src/pages/Services/BigDataAssignmentHelpPage.jsx
import { motion } from "framer-motion";
import { Link } from "react-router-dom";

import Navbar from "../../../components/Navbar/Navbar";
import Footer from "../../../components/Footer/Footer";
import SEO from "../../../components/SEO/SEO";
import styles from "./BigDataAssignmentHelpPage.module.css";

// Shared color language across all diagrams — each role in a data
// pipeline gets one consistent color everywhere it appears, so the
// palette itself teaches the architecture (driver=indigo, compute=amber,
// storage=blue, ephemeral/spot=dashed rose, output=emerald).
const DIAG = {
  driver: { stroke: "#4338ca", fill: "#eef2ff", text: "#3730a3" },
  cluster: { stroke: "#7c3aed", fill: "#f5f3ff", text: "#6d28d9" },
  compute: { stroke: "#ea580c", fill: "#fff7ed", text: "#c2410c" },
  cache: { stroke: "#d97706", fill: "#fffbeb", text: "#b45309" },
  storage: { stroke: "#2563eb", fill: "#eff6ff", text: "#1d4ed8" },
  spot: { stroke: "#e11d48", fill: "#fff1f2", text: "#be123c" },
  output: { stroke: "#059669", fill: "#ecfdf5", text: "#047857" },
  neutral: { stroke: "#64748b", fill: "#f8fafc", text: "#475569" },
};

function HeroDataFlowViz() {
  const stages = [
    { id: "sources", x: 45, y: 100, r: 26, ...DIAG.neutral, label: "Sources", sub: "DBs · logs · IoT" },
    { id: "ingest", x: 185, y: 55, r: 24, ...DIAG.spot, label: "Ingest", sub: "Kafka / Kinesis" },
    { id: "lake", x: 185, y: 150, r: 24, ...DIAG.storage, label: "Data Lake", sub: "S3 / HDFS" },
    { id: "spark", x: 345, y: 100, r: 28, ...DIAG.compute, label: "Spark", sub: "ETL + ML" },
    { id: "insights", x: 495, y: 100, r: 26, ...DIAG.output, label: "Insights", sub: "BI / dashboards" },
  ];
  const edges = [
    ["sources", "ingest"],
    ["sources", "lake"],
    ["ingest", "spark"],
    ["lake", "spark"],
    ["spark", "insights"],
  ];
  const byId = Object.fromEntries(stages.map((n) => [n.id, n]));

  return (
    <svg viewBox="0 0 560 210" className={styles.heroVizSvg} role="img" aria-label="Big data pipeline: sources to insights">
      {edges.map(([from, to], i) => {
        const a = byId[from];
        const b = byId[to];
        return (
          <g key={i}>
            <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} stroke={b.stroke} strokeWidth="1.5" opacity="0.25" />
            <motion.circle
              r="4.5"
              fill={b.stroke}
              animate={{ cx: [a.x, b.x], cy: [a.y, b.y], opacity: [0, 1, 1, 0] }}
              transition={{ duration: 2.2, repeat: Infinity, repeatDelay: 0.6, delay: i * 0.3, ease: "easeInOut" }}
            />
          </g>
        );
      })}
      {stages.map((n) => (
        <g key={n.id}>
          <motion.circle
            cx={n.x}
            cy={n.y}
            r={n.r}
            fill={n.fill}
            stroke={n.stroke}
            strokeWidth="1.75"
            animate={{ scale: [1, 1.06, 1] }}
            transition={{ duration: 2.6, repeat: Infinity, ease: "easeInOut" }}
            style={{ transformOrigin: `${n.x}px ${n.y}px` }}
          />
          <text x={n.x} y={n.y + n.r + 16} textAnchor="middle" fontSize="11" fontWeight="600" fill={n.text}>
            {n.label}
          </text>
          <text x={n.x} y={n.y + n.r + 29} textAnchor="middle" fontSize="9" fill={n.text} opacity="0.75">
            {n.sub}
          </text>
        </g>
      ))}
    </svg>
  );
}

// --- Inline diagram components ---------------------------------------
// The original scraped content had `src="..."` placeholders for these
// (truncated Wix URLs that never resolved to anything). Rather than
// depend on external links that can rot or 404, these are self-contained,
// subject-accurate SVGs — the goal is to show real internals (driver/
// executor split, HDFS replication, the MapReduce shuffle) rather than
// generic connected boxes.

function SparkArchitectureViz() {
  const workers = [0, 1, 2];
  return (
    <svg viewBox="0 0 560 320" className={styles.diagramSvg} role="img" aria-label="Apache Spark cluster architecture: driver, cluster manager, and executors">
      {/* Driver Program */}
      <rect x="185" y="10" width="190" height="66" rx="10" fill={DIAG.driver.fill} stroke={DIAG.driver.stroke} strokeWidth="1.75" />
      <text x="280" y="30" textAnchor="middle" fontSize="12.5" fontWeight="700" fill={DIAG.driver.text}>Driver Program</text>
      <text x="280" y="47" textAnchor="middle" fontSize="9.5" fill={DIAG.driver.text} opacity="0.85">SparkContext · DAG Scheduler</text>
      <text x="280" y="60" textAnchor="middle" fontSize="9.5" fill={DIAG.driver.text} opacity="0.85">Task Scheduler</text>

      {/* Cluster Manager */}
      <line x1="280" y1="76" x2="280" y2="104" stroke={DIAG.cluster.stroke} strokeWidth="1.5" opacity="0.5" />
      <text x="292" y="94" fontSize="9" fill={DIAG.cluster.text} opacity="0.75">negotiates resources</text>
      <rect x="150" y="104" width="260" height="40" rx="10" fill={DIAG.cluster.fill} stroke={DIAG.cluster.stroke} strokeWidth="1.75" />
      <text x="280" y="129" textAnchor="middle" fontSize="11.5" fontWeight="700" fill={DIAG.cluster.text}>
        Cluster Manager — YARN / Mesos / Standalone
      </text>

      {/* Worker nodes with executors */}
      {workers.map((i) => {
        const wx = 25 + i * 185;
        return (
          <g key={i}>
            <line x1={280} y1="144" x2={wx + 75} y2="176" stroke={DIAG.cluster.stroke} strokeWidth="1.25" opacity="0.35" />
            <line x1={280} y1="60" x2={wx + 75} y2="176" stroke={DIAG.driver.stroke} strokeWidth="1" opacity="0.2" strokeDasharray="3 3" />
            <rect x={wx} y="176" width="150" height="122" rx="10" fill="#ffffff" stroke={DIAG.neutral.stroke} strokeWidth="1.5" />
            <text x={wx + 75} y="195" textAnchor="middle" fontSize="10.5" fontWeight="700" fill={DIAG.neutral.text}>
              Worker Node {i + 1}
            </text>
            <rect x={wx + 10} y="205" width="130" height="82" rx="8" fill={DIAG.compute.fill} stroke={DIAG.compute.stroke} strokeWidth="1.5" />
            <text x={wx + 75} y="221" textAnchor="middle" fontSize="10" fontWeight="700" fill={DIAG.compute.text}>Executor</text>
            <rect x={wx + 18} y="228" width="114" height="18" rx="4" fill={DIAG.cache.fill} stroke={DIAG.cache.stroke} strokeWidth="1.25" />
            <text x={wx + 75} y="241" textAnchor="middle" fontSize="8.5" fill={DIAG.cache.text}>Cache (in-memory RDD)</text>
            {[0, 1, 2].map((t) => (
              <rect
                key={t}
                x={wx + 18 + t * 39}
                y="252"
                width="33"
                height="26"
                rx="4"
                fill={DIAG.driver.fill}
                stroke={DIAG.driver.stroke}
                strokeWidth="1"
              />
            ))}
            <text x={wx + 75} y="271" textAnchor="middle" fontSize="7.5" fill={DIAG.driver.text} opacity="0.8">
              tasks (threads)
            </text>
          </g>
        );
      })}
    </svg>
  );
}

function EmrArchitectureViz() {
  return (
    <svg viewBox="0 0 560 340" className={styles.diagramSvg} role="img" aria-label="Amazon EMR cluster architecture with master, core, task nodes, and S3">
      {/* Master node */}
      <rect x="200" y="10" width="160" height="56" rx="10" fill={DIAG.driver.fill} stroke={DIAG.driver.stroke} strokeWidth="1.75" />
      <text x="280" y="30" textAnchor="middle" fontSize="11.5" fontWeight="700" fill={DIAG.driver.text}>Master Node</text>
      <text x="280" y="45" textAnchor="middle" fontSize="9" fill={DIAG.driver.text} opacity="0.85">YARN ResourceManager</text>
      <text x="280" y="57" textAnchor="middle" fontSize="9" fill={DIAG.driver.text} opacity="0.85">HDFS NameNode</text>

      {/* Core nodes (persistent, HDFS + compute) */}
      {[0, 1].map((i) => {
        const cx = 60 + i * 190;
        return (
          <g key={i}>
            <line x1="280" y1="66" x2={cx + 85} y2="94" stroke={DIAG.driver.stroke} strokeWidth="1.25" opacity="0.35" />
            <rect x={cx} y="94" width="170" height="76" rx="10" fill={DIAG.storage.fill} stroke={DIAG.storage.stroke} strokeWidth="1.75" />
            <text x={cx + 85} y="113" textAnchor="middle" fontSize="11" fontWeight="700" fill={DIAG.storage.text}>
              Core Node {i + 1}
            </text>
            <text x={cx + 85} y="128" textAnchor="middle" fontSize="8.5" fill={DIAG.storage.text} opacity="0.85">
              NodeManager + DataNode
            </text>
            {[0, 1, 2].map((b) => (
              <rect
                key={b}
                x={cx + 20 + b * 45}
                y="137"
                width="35"
                height="20"
                rx="4"
                fill={DIAG.storage.stroke}
                opacity="0.18"
                stroke={DIAG.storage.stroke}
                strokeWidth="1"
              />
            ))}
            <text x={cx + 85} y="164" textAnchor="middle" fontSize="7.5" fill={DIAG.storage.text} opacity="0.75">
              replicated HDFS blocks
            </text>
          </g>
        );
      })}

      {/* Task node — ephemeral, compute-only, spot */}
      <line x1="280" y1="66" x2="280" y2="94" stroke={DIAG.spot.stroke} strokeWidth="1.25" opacity="0.4" />
      <rect x="215" y="94" width="130" height="76" rx="10" fill={DIAG.spot.fill} stroke={DIAG.spot.stroke} strokeWidth="1.75" strokeDasharray="5 4" />
      <text x="280" y="113" textAnchor="middle" fontSize="11" fontWeight="700" fill={DIAG.spot.text}>Task Node</text>
      <text x="280" y="128" textAnchor="middle" fontSize="8" fill={DIAG.spot.text} opacity="0.85">NodeManager only</text>
      <text x="280" y="140" textAnchor="middle" fontSize="8" fill={DIAG.spot.text} opacity="0.85">no HDFS storage</text>
      <text x="280" y="158" textAnchor="middle" fontSize="7.5" fill={DIAG.spot.text} opacity="0.7">(spot, ephemeral, compute-only)</text>

      {/* S3 via EMRFS */}
      <line x1="145" y1="170" x2="200" y2="215" stroke={DIAG.output.stroke} strokeWidth="1.25" opacity="0.4" />
      <line x1="425" y1="170" x2="360" y2="215" stroke={DIAG.output.stroke} strokeWidth="1.25" opacity="0.4" />
      <rect x="180" y="215" width="200" height="52" rx="10" fill={DIAG.output.fill} stroke={DIAG.output.stroke} strokeWidth="1.75" />
      <text x="280" y="238" textAnchor="middle" fontSize="12" fontWeight="700" fill={DIAG.output.text}>Amazon S3</text>
      <text x="280" y="253" textAnchor="middle" fontSize="8.5" fill={DIAG.output.text} opacity="0.85">
        persistent storage, synced via EMRFS
      </text>

      {/* Downstream analytics */}
      <line x1="280" y1="267" x2="280" y2="295" stroke={DIAG.cluster.stroke} strokeWidth="1.25" opacity="0.4" />
      <rect x="180" y="295" width="200" height="34" rx="8" fill={DIAG.cluster.fill} stroke={DIAG.cluster.stroke} strokeWidth="1.5" />
      <text x="280" y="316" textAnchor="middle" fontSize="10.5" fill={DIAG.cluster.text}>Redshift / QuickSight (downstream)</text>
    </svg>
  );
}

function MapReduceWordCountViz() {
  // Real shuffle behavior: identical keys from *different* mappers must
  // converge on the *same* reducer. Color-coding by key (not by mapper)
  // is what actually shows that, instead of pretending each mapper
  // reduces its own output independently.
  const KEY_COLOR = {
    the: "#4f46e5",
    cat: "#e11d48",
    sat: "#0891b2",
    on: "#7c3aed",
    mat: "#65a30d",
    dog: "#d97706",
    ran: "#0d9488",
    to: "#db2777",
  };
  const mappers = [
    { id: 0, y: 20, input: "the cat sat on the mat", tuples: ["the", "cat", "sat", "on", "the", "mat"] },
    { id: 1, y: 150, input: "the dog ran to the cat", tuples: ["the", "dog", "ran", "to", "the", "cat"] },
  ];
  const partitions = [
    { id: 0, y: 20, keys: ["cat", "on"] },
    { id: 1, y: 105, keys: ["the", "sat", "to"] },
    { id: 2, y: 210, keys: ["dog", "mat", "ran"] },
  ];
  const counts = (keys) =>
    keys
      .map((k) => `${k}:${mappers.reduce((n, m) => n + m.tuples.filter((t) => t === k).length, 0)}`)
      .join("  ");

  return (
    <svg viewBox="0 0 640 300" className={styles.diagramSvg} role="img" aria-label="MapReduce word count: map, shuffle, and reduce">
      {mappers.map((m) => (
        <g key={m.id}>
          <rect x="10" y={m.y} width="130" height="54" rx="8" fill={DIAG.neutral.fill} stroke={DIAG.neutral.stroke} strokeWidth="1.5" />
          <text x="75" y={m.y + 18} textAnchor="middle" fontSize="9" fontWeight="700" fill={DIAG.neutral.text}>
            Input split {m.id + 1}
          </text>
          <text x="75" y={m.y + 35} textAnchor="middle" fontSize="8" fill={DIAG.neutral.text} opacity="0.8">
            &quot;{m.input}&quot;
          </text>

          <line x1="140" y1={m.y + 27} x2="175" y2={m.y + 27} stroke={DIAG.compute.stroke} strokeWidth="1.25" opacity="0.5" />
          <rect x="180" y={m.y} width="150" height="54" rx="8" fill={DIAG.compute.fill} stroke={DIAG.compute.stroke} strokeWidth="1.5" />
          <text x="255" y={m.y + 14} textAnchor="middle" fontSize="9" fontWeight="700" fill={DIAG.compute.text}>
            Map Task {m.id + 1}
          </text>
          <foreignObject x="188" y={m.y + 18} width="134" height="32">
            <div className={styles.mrTagRow}>
              {m.tuples.map((w, i) => (
                <span key={i} className={styles.mrTag} style={{ background: KEY_COLOR[w] }}>
                  {w}
                </span>
              ))}
            </div>
          </foreignObject>
        </g>
      ))}

      {/* Shuffle: fan every tuple into the reducer that owns its key,
          regardless of which mapper produced it. */}
      {mappers.flatMap((m) =>
        partitions
          .filter((p) => p.keys.some((k) => m.tuples.includes(k)))
          .map((p) => (
            <line
              key={`${m.id}-${p.id}`}
              x1="330"
              y1={m.y + 27}
              x2="365"
              y2={p.y + 27}
              stroke={DIAG.cluster.stroke}
              strokeWidth="1"
              opacity="0.3"
            />
          ))
      )}
      <text x="347" y="8" textAnchor="middle" fontSize="8.5" fill={DIAG.cluster.text} opacity="0.8">
        shuffle · sort by key
      </text>

      {partitions.map((p) => (
        <g key={p.id}>
          <rect x="370" y={p.y} width="130" height="54" rx="8" fill={DIAG.cluster.fill} stroke={DIAG.cluster.stroke} strokeWidth="1.5" />
          <text x="435" y={p.y + 16} textAnchor="middle" fontSize="9" fontWeight="700" fill={DIAG.cluster.text}>
            Reduce Task {p.id + 1}
          </text>
          <foreignObject x="378" y={p.y + 20} width="114" height="30">
            <div className={styles.mrTagRow}>
              {p.keys.map((k) => (
                <span key={k} className={styles.mrTag} style={{ background: KEY_COLOR[k] }}>
                  {k}
                </span>
              ))}
            </div>
          </foreignObject>

          <line x1="500" y1={p.y + 27} x2="535" y2={p.y + 27} stroke={DIAG.output.stroke} strokeWidth="1.25" opacity="0.5" />
          <rect x="540" y={p.y} width="90" height="54" rx="8" fill={DIAG.output.fill} stroke={DIAG.output.stroke} strokeWidth="1.5" />
          <text x="585" y={p.y + 16} textAnchor="middle" fontSize="8" fontWeight="700" fill={DIAG.output.text}>
            part-r-0000{p.id}
          </text>
          <text x="585" y={p.y + 33} textAnchor="middle" fontSize="7" fill={DIAG.output.text} opacity="0.85">
            {counts(p.keys)}
          </text>
        </g>
      ))}
    </svg>
  );
}

const fadeUp = {
  hidden: { opacity: 0, y: 24 },
  visible: { opacity: 1, y: 0, transition: { duration: 0.5, ease: "easeOut" } },
};
const stagger = {
  hidden: { opacity: 0 },
  visible: { opacity: 1, transition: { staggerChildren: 0.06 } },
};
const VIEWPORT = { once: false, amount: 0.15 };

