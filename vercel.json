{
    "redirects": [
        {
            "source": "/(.*)",
            "has": [{ "type": "host", "value": "scapedatasolutions.com" }],
            "destination": "https://www.scapedatasolutions.com/$1",
            "permanent": true
        }
    ],
    "rewrites": [
        { "source": "/login", "destination": "/index.html" },
        { "source": "/signup", "destination": "/index.html" },
        { "source": "/forgot-password", "destination": "/index.html" },
        { "source": "/reset-password", "destination": "/index.html" },
        { "source": "/verify-email", "destination": "/index.html" },
        { "source": "/dashboard", "destination": "/index.html" },
        { "source": "/dashboard/:path*", "destination": "/index.html" }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                }
            ]
        },
        {
            "source": "/sitemap.xml",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/xml"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600, must-revalidate"
                }
            ]
        },
        {
            "source": "/robots.txt",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "text/plain"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600, must-revalidate"
                }
            ]
        }
    ],
    "installCommand": "npm install --legacy-peer-deps"
}